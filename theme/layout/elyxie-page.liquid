<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{ page_title | default: shop.name }}</title>
  <link rel="canonical" href="{{ canonical_url }}"/>
  <link rel="icon" href="{{ 'elyxie-mark.svg' | asset_url }}"/>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | default: shop.name }}">
  {%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="website">
  {%- if template.suffix == 'story' -%}
    {%- comment -%} https: explícito — el scraper de FB/WhatsApp rechaza URLs //relativas. {%- endcomment -%}
    <meta property="og:image" content="https:{{ 'story-og.jpg' | asset_url }}">
    {%- comment -%} Story carga Three.js desde unpkg al acercarse la escena 3D. {%- endcomment -%}
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
  {%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"/>
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500&display=swap"/>
  {{ 'colors_and_type.css' | asset_url | stylesheet_tag }}
  {%- comment -%} styles.css = la hoja del one-pager: trae el header unificado
    (.nav, .nav__lang, .mobile-drawer…) que el snippet elyxie-nav renderiza.
    Misma hoja en home y páginas = header idéntico por construcción. {%- endcomment -%}
  {{ 'styles.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Native Shopify cart drawer — machinery + elyxie re-skin (elyxie-cart.css). {%- endcomment -%}
  {{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
  {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
  {{ 'component-cart.css' | asset_url | stylesheet_tag }}
  {{ 'component-totals.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-discounts.css' | asset_url | stylesheet_tag }}
  {{ 'elyxie-cart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  {%- comment -%} Lightbox fullscreen compartido (visor con zoom) — mismo módulo
    que usa el homepage; el PDP (elyxie-product.liquid) lo invoca al pulsar la
    imagen principal. {%- endcomment -%}
  <script src="{{ 'lightbox.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}
  {%- comment -%} Default por geolocalización (IP): US/no-hispano → /en, antes de pintar. {%- endcomment -%}
  {% render 'elyxie-lang-geo' %}
  <style>
    :root { --ep-bg: #0A2620; --ep-void: #051613; --ep-ink: #FFFFFF; --ep-champ: #E9D7B1; --ep-gold: #C9A66B; --ep-emerald: #0A2620;
            --ep-serif: "Cormorant Garamond","EB Garamond",Georgia,serif; --ep-sans: "Satoshi","Inter",system-ui,sans-serif; }
    /* Safe defaults for the Dawn cart CSS tokens that appear inside calc() (base.css
       isn't loaded here, so an undefined token would void the whole declaration). */
    :root { --font-body-scale: 1; --font-heading-scale: 1; --border-radius: 0; --border-width: 0; --image-padding: 0; }
    * { box-sizing: border-box; }
    /* Dawn a11y utility — base.css no se carga aquí; sin esto, los labels de
       lector de pantalla (steppers de cantidad, conteo del carrito, etc.) se
       renderizan como texto VISIBLE y rompen el layout. */
    .visually-hidden { position: absolute !important; overflow: hidden; width: 1px; height: 1px;
      margin: -1px; padding: 0; border: 0; clip: rect(0 0 0 0); white-space: nowrap; word-wrap: normal !important; }
    .svg-wrapper { display: inline-flex; }
    /* Dawn's cart CSS is authored on the 1rem = 10px convention; match it so the
       reused component-cart-*.css renders at the intended scale. elyxie's own
       styles are all px/em, so this is inert for them. */
    html { font-size: 62.5%; }
    html, body { margin: 0; }
    body.epage {
      background:
        radial-gradient(ellipse 90% 70% at 50% -10%, rgba(38,96,100,0.28) 0%, rgba(10,38,32,0) 55%),
        linear-gradient(180deg, #0A2620 0%, #07211B 60%, #051613 100%);
      color: var(--ep-ink); font-family: var(--ep-sans); font-weight: 400; -webkit-font-smoothing: antialiased;
      min-height: 100vh; display: flex; flex-direction: column;
    }
    /* El header ahora es el unificado (.nav, fixed): el shell deja sitio
       bajo la barra — 76px desktop, 60px + safe-area en móvil (styles.css). */
    .epage-shell { flex: 1 0 auto; padding-top: 76px; }
    @media (max-width: 767px) {
      .epage-shell { padding-top: calc(60px + env(safe-area-inset-top, 0px)); }
    }
    /* ── Footer ── */
    .epage-foot { flex-shrink: 0; border-top: 1px solid rgba(255,255,255,0.08);
      padding: 56px clamp(20px,5vw,64px) 40px; display: grid; gap: 40px;
      grid-template-columns: 1.4fr repeat(3, 1fr); align-items: start; }
    .epage-foot__mark { display: inline-block; width: 120px; height: 30px; background-color: var(--ep-champ);
      -webkit-mask: url("{{ 'elyxie-wordmark.svg' | asset_url }}") no-repeat left center / contain;
              mask: url("{{ 'elyxie-wordmark.svg' | asset_url }}") no-repeat left center / contain; }
    .epage-foot__tag { margin-top: 14px; font-size: 11px; letter-spacing: 0.3em; color: rgba(255,255,255,0.5); }
    .epage-col__t { font-size: 11px; letter-spacing: 0.3em; color: var(--ep-champ); margin-bottom: 16px; }
    .epage-col a { display: block; color: rgba(255,255,255,0.66); text-decoration: none; font-size: 14px;
      line-height: 2.1; transition: color 240ms ease; }
    .epage-col a:hover { color: #fff; }
    .epage-copy { grid-column: 1 / -1; margin-top: 24px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.06);
      font-size: 11px; letter-spacing: 0.2em; color: rgba(255,255,255,0.4); }
    @media (max-width: 720px){ .epage-foot { grid-template-columns: 1fr 1fr; } }
  </style>
</head>
<body class="epage" data-theme="dark">
  {%- if request.locale.iso_code == 'en' -%}
    {%- assign foot = linklists['elyxie-footer-en'] -%}
  {%- else -%}
    {%- assign foot = linklists['elyxie-footer-es'] -%}
  {%- endif -%}
  {%- comment -%} Header unificado del sitio — el mismo snippet que la home. {%- endcomment -%}
  {% render 'elyxie-nav' %}

  <div class="epage-shell">{{ content_for_layout }}</div>

  <footer class="epage-foot">
    <div>
      <a href="{{ routes.root_url }}" class="epage-foot__mark" aria-label="Elyxie"></a>
      <div class="epage-foot__tag">SACRED WATERS</div>
    </div>
    {%- for col in foot.links -%}
      <div class="epage-col">
        <div class="epage-col__t">{{ col.title }}</div>
        {%- for l in col.links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
      </div>
    {%- endfor -%}
    <div class="epage-copy">© {{ 'now' | date: '%Y' }} Elyxie · {% if request.locale.iso_code == 'en' %}Sacred water from the Black Lagoon of Huancabamba{% else %}Agua sagrada de la Laguna Negra de Huancabamba{% endif %}</div>
  </footer>

  {%- comment -%}
    Cart AJAX bootstrap (mirrors theme.liquid) + native cart drawer, re-skinned
    by elyxie-cart.css. cart.js + quantity-popover.js are emitted by the snippet;
    product-form.js / cart-drawer.js are added after so they run in order.
  {%- endcomment -%}
  <script>
    window.shopUrl = '{{ request.origin }}';
    window.routes = {
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
    };
    window.cartStrings = {
      error: `{{ 'sections.cart.cart_error' | t }}`,
      quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
    };
    window.variantStrings = {
      addToCart: `{{ 'products.product.add_to_cart' | t }}`,
      soldOut: `{{ 'products.product.sold_out' | t }}`,
      unavailable: `{{ 'products.product.unavailable' | t }}`,
      unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
    };
    window.accessibilityStrings = {};
  </script>
  {%- render 'cart-drawer' -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
</body>
</html>
