              </button>
              <button
                class="eacct__link eacct__addr-del"
                type="button"
                aria-label="{% if is_en %}Delete address{% else %}Eliminar dirección{% endif %} {{ forloop.index }}"
                data-target="{{ address.url }}"
                data-confirm-message="{% if is_en %}Are you sure you want to delete this address?{% else %}¿Seguro que quieres eliminar esta dirección?{% endif %}"
              >
