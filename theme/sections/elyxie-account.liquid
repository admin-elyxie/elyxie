                      <input type="text" id="AddressFirstName_{{ form.id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="{% if is_en %}First name{% else %}Nombre{% endif %}">
                    </div>
                    <div class="eacct__field">
                      <label for="AddressLastName_{{ form.id }}">{% if is_en %}Last name{% else %}Apellido{% endif %}</label>
                      <input type="text" id="AddressLastName_{{ form.id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="{% if is_en %}Last name{% else %}Apellido{% endif %}">
                    </div>
                    <div class="eacct__field eacct__field--full">
                      <label for="AddressCompany_{{ form.id }}">{% if is_en %}Company{% else %}Empresa{% endif %}</label>
                      <input type="text" id="AddressCompany_{{ form.id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="{% if is_en %}Company{% else %}Empresa{% endif %}">
                    </div>
                    <div class="eacct__field eacct__field--full">
                      <label for="AddressAddress1_{{ form.id }}">{% if is_en %}Address{% else %}Dirección{% endif %}</label>
                      <input type="text" id="AddressAddress1_{{ form.id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="{% if is_en %}Address{% else %}Dirección{% endif %}">
                    </div>
                    <div class="eacct__field eacct__field--full">
                      <label for="AddressAddress2_{{ form.id }}">{% if is_en %}Apartment, suite, etc.{% else %}Departamento, piso, etc.{% endif %}</label>
                      <input type="text" id="AddressAddress2_{{ form.id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="{% if is_en %}Apartment, suite, etc.{% else %}Departamento, piso, etc.{% endif %}">
                    </div>
                    <div class="eacct__field">
                      <label for="AddressCity_{{ form.id }}">{% if is_en %}City{% else %}Ciudad{% endif %}</label>
                      <input type="text" id="AddressCity_{{ form.id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="{% if is_en %}City{% else %}Ciudad{% endif %}">
                    </div>
                    <div class="eacct__field eacct__select">
                      <label for="AddressCountry_{{ form.id }}">{% if is_en %}Country / Region{% else %}País / Región{% endif %}</label>
                      <select id="AddressCountry_{{ form.id }}" name="address[country]" data-address-country-select data-default="{{ form.country }}" data-form-id="{{ form.id }}" autocomplete="country">
                        {{ all_country_option_tags }}
                      </select>
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </div>
                    <div class="eacct__field eacct__select eacct__field--full" id="AddressProvinceContainer_{{ form.id }}" style="display:none;">
                      <label for="AddressProvince_{{ form.id }}">{% if is_en %}Province{% else %}Provincia{% endif %}</label>
                      <select id="AddressProvince_{{ form.id }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </div>
                    <div class="eacct__field">
                      <label for="AddressZip_{{ form.id }}">{% if is_en %}Postal / ZIP code{% else %}Código postal{% endif %}</label>
                      <input type="text" id="AddressZip_{{ form.id }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="{% if is_en %}Postal / ZIP code{% else %}Código postal{% endif %}">
                    </div>
                    <div class="eacct__field">
                      <label for="AddressPhone_{{ form.id }}">{% if is_en %}Phone{% else %}Teléfono{% endif %}</label>
                      <input type="tel" id="AddressPhone_{{ form.id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{% if is_en %}Phone{% else %}Teléfono{% endif %}">
                    </div>
                  </div>
                  <div class="eacct__checkbox">
                    {{ form.set_as_default_checkbox }}
                    <label for="address_default_address_{{ form.id }}">{% if is_en %}Set as default address{% else %}Usar como dirección predeterminada{% endif %}</label>
                  </div>
                  <div class="eacct__actions">
                    <button class="eacct__btn" type="submit">{% if is_en %}Update address{% else %}Actualizar dirección{% endif %}</button>
                    <button class="eacct__link" type="reset">{% if is_en %}Cancel{% else %}Cancelar{% endif %}</button>
                  </div>
                {%- endform -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="eacct__empty" style="margin-top: clamp(28px,4vw,40px);">{% if is_en %}You have no saved addresses yet.{% else %}Aún no tienes direcciones guardadas.{% endif %}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 and paginate.parts.size > 0 -%}
        <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
          <ul class="eacct__pager" role="list">
            {%- if paginate.previous -%}
              <li><a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></a></li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{- part.title -}}</a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{- part.title -}}</span>
                  {%- else -%}
                    <span>{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li><a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></a></li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    </section>
  {%- endpaginate -%}

  <script src="{{ 'customer.js' | asset_url }}" defer></script>
  <script>
    window.addEventListener('load', () => {
      typeof CustomerAddresses !== 'undefined' && new CustomerAddresses();
    });
  </script>

{%- comment -%} ══════════════════════════════════════════════════════════════
   RAMA 4 — RESET  (reset_customer_password)
   ══════════════════════════════════════════════════════════════ {%- endcomment -%}
{%- elsif p contains '/account/reset' -%}
  <section class="eacct eacct--narrow eacct__reveal">
