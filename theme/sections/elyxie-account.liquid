              </div>
              <div class="eacct__field eacct__field--full">
                <label for="AddressCompanyNew">{% if is_en %}Company{% else %}Empresa{% endif %}</label>
                <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="{% if is_en %}Company{% else %}Empresa{% endif %}">
              </div>
              <div class="eacct__field eacct__field--full">
                <label for="AddressAddress1New">{% if is_en %}Address{% else %}Dirección{% endif %}</label>
                <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="{% if is_en %}Address{% else %}Dirección{% endif %}">
              </div>
              <div class="eacct__field eacct__field--full">
                <label for="AddressAddress2New">{% if is_en %}Apartment, suite, etc.{% else %}Departamento, piso, etc.{% endif %}</label>
                <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="{% if is_en %}Apartment, suite, etc.{% else %}Departamento, piso, etc.{% endif %}">
              </div>
              <div class="eacct__field">
                <label for="AddressCityNew">{% if is_en %}City{% else %}Ciudad{% endif %}</label>
                <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="{% if is_en %}City{% else %}Ciudad{% endif %}">
              </div>
              <div class="eacct__field eacct__select">
                <label for="AddressCountryNew">{% if is_en %}Country / Region{% else %}País / Región{% endif %}</label>
                <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" autocomplete="country">
                  {{ all_country_option_tags }}
                </select>
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </div>
              <div class="eacct__field eacct__select eacct__field--full" id="AddressProvinceContainerNew" style="display: none">
                <label for="AddressProvinceNew">{% if is_en %}Province{% else %}Provincia{% endif %}</label>
                <select id="AddressProvinceNew" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </div>
              <div class="eacct__field">
                <label for="AddressZipNew">{% if is_en %}Postal / ZIP code{% else %}Código postal{% endif %}</label>
                <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="{% if is_en %}Postal / ZIP code{% else %}Código postal{% endif %}">
              </div>
              <div class="eacct__field">
                <label for="AddressPhoneNew">{% if is_en %}Phone{% else %}Teléfono{% endif %}</label>
                <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{% if is_en %}Phone{% else %}Teléfono{% endif %}">
              </div>
            </div>
            <div class="eacct__checkbox">
              {{ form.set_as_default_checkbox }}
              <label for="address_default_address_new">{% if is_en %}Set as default address{% else %}Usar como dirección predeterminada{% endif %}</label>
            </div>
            <div class="eacct__actions">
              <button class="eacct__btn" type="submit">{% if is_en %}Add address{% else %}Añadir dirección{% endif %}</button>
              <button class="eacct__link" type="reset">{% if is_en %}Cancel{% else %}Cancelar{% endif %}</button>
            </div>
          {%- endform -%}
        </div>
      </div>

      {%- comment -%} Lista de direcciones existentes — cada una con edit/delete inline. {%- endcomment -%}
      {%- if customer.addresses.size > 0 -%}
        <ul class="eacct__addr-list" role="list">
          {%- for address in customer.addresses -%}
            <li class="eacct__addr-item" data-address>
              {%- if address == customer.default_address -%}
                <p class="eacct__sublabel">{% if is_en %}Default{% else %}Predeterminada{% endif %}</p>
              {%- endif -%}
              <div class="eacct__address">{{ address | format_address }}</div>
              {%- comment -%} Los botones edit/delete son hermanos DIRECTOS de #EditAddress_
                (el combinador `~` de Dawn los necesita sin wrapper). La fila de acciones
                se compone con CSS (.eacct__addr-toggle/.eacct__addr-del) sin envoltorio. {%- endcomment -%}
              <button
                class="eacct__link eacct__addr-toggle eacct__addr-toggle--edit"
                type="button"
                id="EditFormButton_{{ address.id }}"
                aria-label="{% if is_en %}Edit address{% else %}Editar dirección{% endif %} {{ forloop.index }}"
                aria-controls="EditAddress_{{ address.id }}"
                aria-expanded="false"
