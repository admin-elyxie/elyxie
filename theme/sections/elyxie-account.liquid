    {%- form 'reset_customer_password' -%}
      <div class="eacct__form">
        {%- if form.errors -%}
          <div class="eacct__msg eacct__msg--error" tabindex="-1" autofocus role="alert">
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            <span class="eacct__msg-title">{% if is_en %}Please review the form{% else %}Revisa el formulario{% endif %}</span>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#{{ field }}">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="eacct__field">
          <label for="password">{% if is_en %}New password{% else %}Nueva contraseña{% endif %}</label>
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            {% if form.errors contains 'password' %}aria-invalid="true" aria-describedby="password-error"{% endif %}
            placeholder="{% if is_en %}New password{% else %}Nueva contraseña{% endif %}"
          >
          {%- if form.errors contains 'password' -%}
            <small id="password-error" class="eacct__field-error">
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              {{ form.errors.translated_fields.password | capitalize }}
              {{ form.errors.messages.password }}
            </small>
          {%- endif -%}
        </div>

        <div class="eacct__field">
          <label for="password_confirmation">{% if is_en %}Confirm password{% else %}Confirmar contraseña{% endif %}</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            {% if form.errors contains 'password_confirmation' %}aria-invalid="true" aria-describedby="password_confirmation-error"{% endif %}
            placeholder="{% if is_en %}Confirm password{% else %}Confirmar contraseña{% endif %}"
          >
          {%- if form.errors contains 'password_confirmation' -%}
            <small id="password_confirmation-error" class="eacct__field-error">
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              {{ form.errors.translated_fields.password_confirmation | capitalize }}
              {{ form.errors.messages.password_confirmation }}
            </small>
          {%- endif -%}
        </div>

        <div class="eacct__actions">
          <button class="eacct__btn" type="submit">{% if is_en %}Reset password{% else %}Restablecer contraseña{% endif %}</button>
        </div>
      </div>
    {%- endform -%}
  </section>

{%- comment -%} ══════════════════════════════════════════════════════════════
   RAMA 5 — ACTIVATE  (activate_customer_password)
   ══════════════════════════════════════════════════════════════ {%- endcomment -%}
{%- elsif p contains '/account/activate' -%}
  <section class="eacct eacct--narrow eacct__reveal">
    <p class="eacct__eyebrow">{% if is_en %}Welcome{% else %}Bienvenida{% endif %}</p>
    <h1 class="eacct__title">{% if is_en %}Activate your account{% else %}Activa tu cuenta{% endif %}</h1>
    <div class="eacct__lede"><p>{% if is_en %}Create a password to activate your account.{% else %}Crea una contraseña para activar tu cuenta.{% endif %}</p></div>

    {%- form 'activate_customer_password' -%}
      <div class="eacct__form">
        {%- if form.errors -%}
          <div class="eacct__msg eacct__msg--error" tabindex="-1" autofocus role="alert">
            <span class="eacct__msg-title">{% if is_en %}Please review the form{% else %}Revisa el formulario{% endif %}</span>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#{{ field }}">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="eacct__field">
          <label for="password">{% if is_en %}Password{% else %}Contraseña{% endif %}</label>
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            placeholder="{% if is_en %}Password{% else %}Contraseña{% endif %}"
            {% if form.errors contains 'password' %}aria-invalid="true" aria-describedby="password-error"{% endif %}
          >
          {%- if form.errors contains 'password' -%}
            <small id="password-error" class="eacct__field-error">
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              {{ form.errors.translated_fields.password | capitalize }}
              {{ form.errors.messages.password }}
            </small>
          {%- endif -%}
        </div>

        <div class="eacct__field">
          <label for="password_confirmation">{% if is_en %}Confirm password{% else %}Confirmar contraseña{% endif %}</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            placeholder="{% if is_en %}Confirm password{% else %}Confirmar contraseña{% endif %}"
            {% if form.errors contains 'password' %}aria-invalid="true" aria-describedby="password_confirmation-error"{% endif %}
          >
          {%- if form.errors contains 'password_confirmation' -%}
            <small id="password_confirmation-error" class="eacct__field-error">
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              {{ form.errors.translated_fields.password_confirmation | capitalize }}
              {{ form.errors.messages.password_confirmation }}
            </small>
          {%- endif -%}
        </div>

        <div class="eacct__actions">
          <button class="eacct__btn" type="submit">{% if is_en %}Activate account{% else %}Activar cuenta{% endif %}</button>
          <button class="eacct__link" name="decline" type="submit">{% if is_en %}Decline invitation{% else %}Rechazar invitación{% endif %}</button>
        </div>
      </div>
    {%- endform -%}
  </section>

{%- comment -%} ══════════════════════════════════════════════════════════════
   RAMA 6 — DETALLE DE PEDIDO  (objeto `order`)
   Coincide en /account/orders/<id> (un pedido suelto), no en el listado raíz.
   ══════════════════════════════════════════════════════════════ {%- endcomment -%}
{%- elsif order != blank -%}
  <section class="eacct eacct__reveal">
    <p class="eacct__eyebrow">{% if is_en %}Order{% else %}Pedido{% endif %}</p>
    <h1 class="eacct__title">{% if is_en %}Order {{ order.name }}{% else %}Pedido {{ order.name }}{% endif %}</h1>
    <div class="eacct__lede" style="margin-bottom: 16px;">
      <a class="eacct__link eacct__link--back" href="{{ routes.account_url }}">
        <svg width="13" height="9" viewBox="0 0 13 9" fill="none" aria-hidden="true"><path d="M1 4.5h10M7.5 1L11 4.5 7.5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {% if is_en %}Back to account{% else %}Volver a la cuenta{% endif %}
      </a>
    </div>

    {%- assign order_date = order.created_at | time_tag: format: 'date_at_time' -%}
    <div class="eacct__order-meta">
      <p>{{ 'customer.order.date_html' | t: date: order_date }}</p>
      {%- if order.cancelled -%}
        {%- assign cancelled_at = order.cancelled_at | time_tag: format: 'date_at_time' -%}
        <p>{{ 'customer.order.cancelled_html' | t: date: cancelled_at }}</p>
        <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>
      {%- endif -%}
    </div>

    <div class="eacct__table-wrap" style="margin-top: clamp(28px,4vw,40px);">
      <table role="table" class="eacct__table eacct__order-table">
        <caption class="visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th id="ColumnProduct" scope="col" role="columnheader">{% if is_en %}Product{% else %}Producto{% endif %}</th>
            <th id="ColumnSku" scope="col" role="columnheader">{% if is_en %}SKU{% else %}SKU{% endif %}</th>
            <th id="ColumnPrice" scope="col" role="columnheader" data-num>{% if is_en %}Price{% else %}Precio{% endif %}</th>
            <th id="ColumnQuantity" scope="col" role="columnheader" data-num>{% if is_en %}Qty{% else %}Cant.{% endif %}</th>
            <th id="ColumnTotal" scope="col" role="columnheader" data-num>{% if is_en %}Total{% else %}Total{% endif %}</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {%- for line_item in order.line_items -%}
            <tr role="row">
              <td id="Row{{ line_item.key }}" headers="ColumnProduct" role="rowheader" scope="row" data-label="{% if is_en %}Product{% else %}Producto{% endif %}">
                <div>
                  {%- if line_item.url != blank -%}
                    <a href="{{ line_item.url }}">{{ line_item.title | escape }}</a>
                  {%- else -%}
                    <p>{{ line_item.title | escape }}</p>
                  {%- endif -%}
                  {%- assign property_size = line_item.properties | size -%}
                  {%- unless line_item.selling_plan_allocation == null and property_size == 0 -%}
                    <div class="properties">
                      {%- unless line_item.product.has_only_default_variant -%}
                        <span>{{ line_item.variant.title | escape }}</span>
                      {%- endunless -%}
                      {%- unless line_item.selling_plan_allocation == null -%}
                        <span>{{ line_item.selling_plan_allocation.selling_plan.name }}</span>
                      {%- endunless -%}
                      {%- if property_size != 0 -%}
                        {%- for property in line_item.properties -%}
                          {% assign property_first_char = property.first | slice: 0 %}
                          {%- if property.last != blank and property_first_char != '_' -%}
                            <span>{{ property.first }}:</span>
                            <span>
                              {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                              {%- else -%}
                                {{ property.last }}
                              {%- endif -%}
                            </span>
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                    </div>
                  {%- endunless -%}

                  {%- if line_item.line_level_discount_allocations != blank -%}
                    <ul role="list" aria-label="{% if is_en %}Discount{% else %}Descuento{% endif %}">
                      {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                        <li>
                          <span class="svg-wrapper">{{- 'icon-discount.svg' | inline_asset_content -}}</span>
                          {{- discount_allocation.discount_application.title | escape }} (-
                          {{- discount_allocation.amount | money -}})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- if line_item.fulfillment -%}
                    <div class="fulfillment">
                      {%- assign created_at = line_item.fulfillment.created_at | time_tag: format: 'date' -%}
                      <span>{{ 'customer.order.fulfilled_at_html' | t: date: created_at }}</span>
                      {%- if line_item.fulfillment.tracking_url -%}
                        <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track_shipment' | t }}</a>
                      {%- endif -%}
                      <span>
                        {{ line_item.fulfillment.tracking_company }}
                        {%- if line_item.fulfillment.tracking_number -%}#{{ line_item.fulfillment.tracking_number }}{%- endif -%}
                      </span>
                    </div>
                  {%- endif -%}
                </div>
              </td>
              <td headers="Row{{ line_item.key }} ColumnSku" role="cell" data-label="{% if is_en %}SKU{% else %}SKU{% endif %}">{{ line_item.sku }}</td>
              <td headers="Row{{ line_item.key }} ColumnPrice" role="cell" data-num data-label="{% if is_en %}Price{% else %}Precio{% endif %}">
                {%- if line_item.original_price != line_item.final_price or line_item.unit_price_measurement -%}
                  <dl>
                    {%- if line_item.original_price != line_item.final_price -%}
                      <dt><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span></dt>
                      <dd class="regular-price"><s>{{ line_item.original_price | money }}</s></dd>
                      <dt><span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span></dt>
                      <dd><span>{{ line_item.final_price | money }}</span></dd>
                    {%- else -%}
                      <dt><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span></dt>
                      <dd>{{ line_item.original_price | money }}</dd>
                    {%- endif -%}
                    {%- if line_item.unit_price_measurement -%}
                      <dt><span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span></dt>
                      <dd class="unit-price">{% render 'unit-price', price: line_item.unit_price, measurement: line_item.unit_price_measurement, hide_accessibility_label: true %}</dd>
                    {%- endif -%}
                  </dl>
                {%- else -%}
                  <span>{{ line_item.final_price | money }}</span>
                {%- endif -%}
              </td>
              <td headers="Row{{ line_item.key }} ColumnQuantity" role="cell" data-num data-label="{% if is_en %}Qty{% else %}Cant.{% endif %}">{{ line_item.quantity }}</td>
              <td headers="Row{{ line_item.key }} ColumnTotal" role="cell" data-num data-label="{% if is_en %}Total{% else %}Total{% endif %}">
                {%- if line_item.original_line_price != line_item.final_line_price -%}
                  <dl>
                    <dt><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span></dt>
                    <dd class="regular-price"><s>{{ line_item.original_line_price | money }}</s></dd>
                    <dt><span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span></dt>
                    <dd><span>{{ line_item.final_line_price | money }}</span></dd>
                  </dl>
                {%- else -%}
                  {{ line_item.original_line_price | money }}
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot role="rowgroup">
          <tr role="row">
            <td id="RowSubtotal" role="rowheader" scope="row" colspan="4">{% if is_en %}Subtotal{% else %}Subtotal{% endif %}</td>
            <td headers="RowSubtotal" role="cell" data-num data-label="{% if is_en %}Subtotal{% else %}Subtotal{% endif %}">{{ order.line_items_subtotal_price | money }}</td>
          </tr>
          {%- if order.cart_level_discount_applications != blank -%}
            <tr role="row">
              {%- for discount_application in order.cart_level_discount_applications -%}
                <td id="RowDiscount" role="rowheader" scope="row" colspan="4">
                  {% if is_en %}Discount{% else %}Descuento{% endif %}
                  <span class="cart-discount">
                    <span class="svg-wrapper">{{- 'icon-discount.svg' | inline_asset_content -}}</span>
                    {{- discount_application.title | escape -}}
                  </span>
                </td>
                <td headers="RowDiscount" role="cell" data-num data-label="{% if is_en %}Discount{% else %}Descuento{% endif %}">
                  <div>
                    <span>-{{ discount_application.total_allocated_amount | money }}</span>
                    <span class="cart-discount">
                      <span class="svg-wrapper">{{- 'icon-discount.svg' | inline_asset_content -}}</span>
                      {{- discount_application.title | escape -}}
                    </span>
                  </div>
                </td>
              {%- endfor -%}
            </tr>
          {%- endif -%}
          {%- for shipping_method in order.shipping_methods -%}
            <tr role="row">
              <td id="RowShipping" role="rowheader" scope="row" colspan="4">{% if is_en %}Shipping{% else %}Envío{% endif %} ({{ shipping_method.title | escape }})</td>
              <td headers="RowShipping" role="cell" data-num data-label="{% if is_en %}Shipping{% else %}Envío{% endif %} ({{ shipping_method.title | escape }})">{{ shipping_method.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr role="row">
              <td id="RowTax" role="rowheader" scope="row" colspan="4">{% if is_en %}Tax{% else %}Impuestos{% endif %} ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)</td>
              <td headers="RowTax" role="cell" data-num data-label="{% if is_en %}Tax{% else %}Impuestos{% endif %} ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)">{{ tax_line.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- if order.total_duties -%}
            <tr role="row">
              <td id="RowDuties" role="rowheader" scope="row" colspan="4">{% if is_en %}Duties{% else %}Aranceles{% endif %}</td>
              <td headers="RowDuties" role="cell" data-num data-label="{% if is_en %}Duties{% else %}Aranceles{% endif %}">{{ order.total_duties | money }}</td>
            </tr>
          {%- endif -%}
          {%- if order.total_refunded_amount > 0 -%}
            <tr role="row">
              <td id="RowTotalRefund" role="rowheader" scope="row" colspan="3">{% if is_en %}Refunded{% else %}Reembolsado{% endif %}</td>
              <td headers="RowTotalRefund" role="cell" colspan="2" data-num data-label="{% if is_en %}Refunded{% else %}Reembolsado{% endif %}">-{{ order.total_refunded_amount | money_with_currency }}</td>
            </tr>
          {%- endif -%}
          <tr role="row">
            <td id="RowTotal" role="rowheader" scope="row" colspan="3">{% if is_en %}Total{% else %}Total{% endif %}</td>
            <td headers="RowTotal" role="cell" colspan="2" data-num data-label="{% if is_en %}Total{% else %}Total{% endif %}">{{ order.total_net_amount | money_with_currency }}</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="eacct__order-addresses">
      <div class="eacct__card">
        <h2 class="eacct__card-title" style="margin-bottom: 16px;">{% if is_en %}Billing address{% else %}Dirección de facturación{% endif %}</h2>
        <p class="eacct__order-meta" style="margin: 0 0 14px;"><strong>{% if is_en %}Payment status{% else %}Estado del pago{% endif %}:</strong> {{ order.financial_status_label }}</p>
        <div class="eacct__address">{{ order.billing_address | format_address }}</div>
      </div>
      <div class="eacct__card">
        <h2 class="eacct__card-title" style="margin-bottom: 16px;">{% if is_en %}Shipping address{% else %}Dirección de envío{% endif %}</h2>
        <p class="eacct__order-meta" style="margin: 0 0 14px;"><strong>{% if is_en %}Fulfillment status{% else %}Estado del envío{% endif %}:</strong> {{ order.fulfillment_status_label }}</p>
        <div class="eacct__address">{{ order.shipping_address | format_address }}</div>
      </div>
    </div>
  </section>

{%- comment -%} ══════════════════════════════════════════════════════════════
   RAMA 7 (else) — PANEL DE CUENTA  (bienvenida + pedidos + direcciones + salir)
   ══════════════════════════════════════════════════════════════ {%- endcomment -%}
{%- else -%}
  <section class="eacct eacct__reveal">
    <header>
      <p class="eacct__eyebrow">{% if is_en %}Your Account{% else %}Tu Cuenta{% endif %}</p>
      <h1 class="eacct__title">
        {%- if customer.first_name != blank -%}
          {% if is_en %}Welcome, {{ customer.first_name }}{% else %}Bienvenida, {{ customer.first_name }}{% endif %}
        {%- else -%}
          {% if is_en %}Your account{% else %}Tu cuenta{% endif %}
        {%- endif -%}
      </h1>
      <div class="eacct__lede" style="margin-bottom: 4px;">
        <a class="eacct__link" href="{{ routes.account_logout_url }}">
          {% if is_en %}Sign out{% else %}Cerrar sesión{% endif %}
          <svg width="13" height="9" viewBox="0 0 13 9" fill="none" aria-hidden="true"><path d="M1 4.5h10M7.5 1L11 4.5 7.5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </header>

    <div class="eacct__grid">
      {%- comment -%} Pedidos recientes. {%- endcomment -%}
      <div class="eacct__card">
        <div class="eacct__card-head">
          <h2 class="eacct__card-title">{% if is_en %}Orders{% else %}Pedidos{% endif %}</h2>
        </div>

        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="eacct__table-wrap">
              <table role="table" class="eacct__table">
                <caption class="visually-hidden">{% if is_en %}Orders{% else %}Pedidos{% endif %}</caption>
                <thead role="rowgroup">
                  <tr role="row">
                    <th id="ColumnOrder" scope="col" role="columnheader">{% if is_en %}Order{% else %}Pedido{% endif %}</th>
                    <th id="ColumnDate" scope="col" role="columnheader">{% if is_en %}Date{% else %}Fecha{% endif %}</th>
                    <th id="ColumnPayment" scope="col" role="columnheader">{% if is_en %}Payment{% else %}Pago{% endif %}</th>
                    <th id="ColumnFulfillment" scope="col" role="columnheader">{% if is_en %}Fulfillment{% else %}Envío{% endif %}</th>
                    <th id="ColumnTotal" scope="col" role="columnheader" data-num>{% if is_en %}Total{% else %}Total{% endif %}</th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {%- for order in customer.orders -%}
                    <tr role="row">
                      <td id="RowOrder" role="cell" headers="ColumnOrder" data-label="{% if is_en %}Order{% else %}Pedido{% endif %}">
                        <a href="{{ order.customer_url }}" aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}">{{ order.name }}</a>
                      </td>
                      <td headers="RowOrder ColumnDate" role="cell" data-label="{% if is_en %}Date{% else %}Fecha{% endif %}">{{ order.created_at | time_tag: format: 'date' }}</td>
                      <td headers="RowOrder ColumnPayment" role="cell" data-label="{% if is_en %}Payment{% else %}Pago{% endif %}">{{ order.financial_status_label }}</td>
                      <td headers="RowOrder ColumnFulfillment" role="cell" data-label="{% if is_en %}Fulfillment{% else %}Envío{% endif %}">{{ order.fulfillment_status_label }}</td>
                      <td headers="RowOrder ColumnTotal" role="cell" data-num data-label="{% if is_en %}Total{% else %}Total{% endif %}">{{ order.total_net_amount | money_with_currency }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <p class="eacct__empty">{% if is_en %}You have no orders yet.{% else %}Aún no tienes pedidos.{% endif %}</p>
          {%- endif -%}

          {%- if paginate.pages > 1 and paginate.parts.size > 0 -%}
            <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
              <ul class="eacct__pager" role="list">
                {%- if paginate.previous -%}
                  <li><a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></a></li>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{- part.title -}}</a>
                    {%- else -%}
                      {%- if part.title == paginate.current_page -%}
                        <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{- part.title -}}</span>
                      {%- else -%}
                        <span>{{ part.title }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                {%- if paginate.next -%}
                  <li><a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></a></li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      {%- comment -%} Direcciones (predeterminada) + enlace a la gestión completa. {%- endcomment -%}
      <div class="eacct__card">
        <div class="eacct__card-head">
          <h2 class="eacct__card-title">{% if is_en %}Details{% else %}Datos{% endif %}</h2>
        </div>

        {%- if customer.default_address != blank -%}
          <p class="eacct__sublabel">{% if is_en %}Default address{% else %}Dirección predeterminada{% endif %}</p>
          <div class="eacct__address">{{ customer.default_address | format_address }}</div>
        {%- else -%}
          <p class="eacct__empty" style="font-size: 17px;">{% if is_en %}No saved address yet.{% else %}Sin dirección guardada.{% endif %}</p>
        {%- endif -%}

        <div class="eacct__actions" style="margin-top: 24px;">
          <a class="eacct__btn eacct__btn--ghost" href="{{ routes.account_addresses_url }}">
            {% if is_en %}View addresses ({{ customer.addresses_count }}){% else %}Ver direcciones ({{ customer.addresses_count }}){% endif %}
          </a>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

