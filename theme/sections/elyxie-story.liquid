<div id="elyxie-story" class="story" data-glb="{{ 'angel.glb' | asset_url }}">
  <script>
    /* Armado PRE-PAINT: este inline corre mientras el parser aún está dentro
       del div (el elemento ya existe en el DOM), o sea ANTES del primer paint.
       Sin esto, el layout apilado (fallback) parpadearía un frame hasta que el
       story-scroll.js diferido armara la clase. Reduced-motion nunca se arma. */
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.getElementById('elyxie-story').classList.add('story--armed');
    }
  </script>

  <div class="story__bg" aria-hidden="true"></div>
  <div class="story-grain" aria-hidden="true"></div>

  {%- comment -%} Rail de escenas — decorativo puro; el motor lo enciende. {%- endcomment -%}
  <div class="story-rail" aria-hidden="true">
    <span class="story-rail__track"><span class="story-rail__fill"></span></span>
    <span class="story-rail__dot" data-for="paramo"></span>
    <span class="story-rail__dot" data-for="encanto"></span>
    <span class="story-rail__dot" data-for="mesa"></span>
    <span class="story-rail__dot" data-for="seguro"></span>
    <span class="story-rail__dot" data-for="viva"></span>
  </div>

  {%- comment -%} ══ ESCENA 01 · PARAMO ══ {%- endcomment -%}
  <section class="story-scene" data-scene="paramo"
    data-theme-from="#0A2620" data-theme-to="#051613"
    data-fg-from="#FFFFFF" data-fg-to="#FFFFFF"
    data-ramp="0.75,1" style="--len: 4">
    <div class="story-scene__pin">
      <div class="story-scene__media">
        <picture>
          <source media="(max-width: 600px)" sizes="100vw"
            srcset="{{ 'story-paramo-bg-480.webp' | asset_url }} 480w, {{ 'story-paramo-bg-960.webp' | asset_url }} 960w">
          <img
            src="{{ 'story-paramo-bg-960.webp' | asset_url }}"
            srcset="{{ 'story-paramo-bg-480.webp' | asset_url }} 480w, {{ 'story-paramo-bg-960.webp' | asset_url }} 960w, {{ 'story-paramo-bg-1440.webp' | asset_url }} 1440w"
            sizes="100vw" width="960" height="536" fetchpriority="high" decoding="async"
            alt="{% if is_en %}Low mist over the páramo of Las Huaringas, in Huancabamba{% else %}Niebla baja sobre el páramo de las Huaringas, en Huancabamba{% endif %}">
        </picture>
        <video class="story-video" muted playsinline loop preload="none" aria-hidden="true"
          poster="{{ 'story-paramo-bg-960.webp' | asset_url }}"
          data-src="{{ 'origen-bg.mp4' | asset_url }}"
          data-src-720="{{ 'origen-bg-720.mp4' | asset_url }}"></video>
      </div>
      <div class="story-scene__scrim" aria-hidden="true"></div>
      {{ s1_beats }}
    </div>
  </section>

  {%- comment -%} ══ ESCENA 02 · ENCANTO ══ {%- endcomment -%}
  <section class="story-scene" data-scene="encanto"
    data-theme-from="#051613" data-theme-to="#020807"
    data-fg-from="#FFFFFF" data-fg-to="#FFFFFF"
    data-ramp="0.75,1" style="--len: 4">
    <div class="story-scene__pin">
      <div class="story-scene__media">
        <picture>
          {%- comment -%} -m-*: recorte vertical art-directed para móvil {%- endcomment -%}
          <source media="(max-width: 600px)"
            srcset="{{ 'story-encanto-bg-m-480.webp' | asset_url }} 480w, {{ 'story-encanto-bg-m-960.webp' | asset_url }} 960w"
