            src="{{ 'story-amanecer-bg-960.webp' | asset_url }}"
            srcset="{{ 'story-amanecer-bg-480.webp' | asset_url }} 480w, {{ 'story-amanecer-bg-960.webp' | asset_url }} 960w, {{ 'story-amanecer-bg-1440.webp' | asset_url }} 1440w"
