{%- comment -%}
  Artículo ELYXIE — un relato (post de blog). Re-skin de Dawn `main-article.liquid`.
  Vive bajo el layout `elyxie-page`. Columna editorial estrecha centrada; el cuerpo
  (article.content) usa las mismas reglas `.epc-rte` que las páginas de contenido;
  el form de comentarios reusa la maquinaria `.econt__*` del contacto. Bilingüe ES/EN.

  CONSERVADO 1:1 de Dawn (no tocar el comportamiento Shopify):
  - {% form 'new_comment', article %} con campos comment[author]/comment[email]/comment[body],
    ids CommentForm-author/email/body, aria, ramas form.errors / form.posted_successfully? y la
    lógica de moderación (success vs success_moderated, blog.moderated?).
  - {% paginate article.comments by 5 %} con anchor #Comments-<id>.
  - <script type="application/ld+json">{{ article | structured_data }}</script> (SEO).
  Share: implementado inline (Web Share API + copia) en vez del snippet Dawn, para no
  depender de base.css ni de un block (sin blocks en esta sección).
{%- endcomment -%}
{%- assign is_en = false -%}
{%- if request.locale.iso_code == 'en' -%}{%- assign is_en = true -%}{%- endif -%}

<style>
  .eart { --ea-ink: #FFFFFF; --ea-body: rgba(255,255,255,0.80); --ea-body-soft: rgba(255,255,255,0.62);
    --ea-champ: var(--ep-champ); --ea-hair: rgba(255,255,255,0.10); --ea-hair-faint: rgba(255,255,255,0.07);
    --ea-hair-champ: rgba(233,215,177,0.40); --ea-bronze: #D97757;
    --ea-field-bg: rgba(255,255,255,0.04); --ea-field-bg-focus: rgba(255,255,255,0.06); --ea-field-line: rgba(255,255,255,0.18);
    --ea-measure: 720px;
    position: relative; width: 100%; padding: clamp(48px,8vw,112px) 24px clamp(72px,11vw,148px);
    color: var(--ea-body); font-family: var(--ep-sans); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  .eart-inner { max-width: var(--ea-measure); margin: 0 auto; }

  /* ── Cabecera ── */
  .eart-head { text-align: center; margin-bottom: clamp(34px,5vw,56px); }
  .eart-back-top { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 clamp(18px,2.4vw,28px);
    font-family: var(--ep-sans); font-size: 10px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--ea-champ); text-decoration: none; transition: color 240ms ease; }
  .eart-back-top:hover { color: #fff; }
  .eart-title { margin: 0; font-family: var(--ep-serif); font-style: italic; font-weight: 400;
    font-size: clamp(38px,6vw,76px); line-height: 1.04; letter-spacing: -0.02em; color: var(--ea-ink); text-wrap: balance; }
  .eart-meta { display: inline-flex; align-items: center; gap: 12px; margin-top: clamp(16px,2vw,24px);
    font-family: var(--ep-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(255,255,255,0.55); font-variant-numeric: tabular-nums; }
  .eart-meta__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ea-champ); opacity: 0.6; }

  /* ── Hero ── */
  .eart-hero { margin: clamp(32px,5vw,56px) 0 clamp(40px,6vw,64px); border-radius: 16px; overflow: hidden;
    box-shadow: 0 24px 70px rgba(5,22,19,0.5), inset 0 0 0 1px rgba(255,255,255,0.06); }
  .eart-hero img { display: block; width: 100%; height: auto; }

  /* ── Rich text del cuerpo (mismas reglas que las páginas de contenido) ── */
  .epc-rte { font-size: clamp(16px, 1.05vw + 13px, 18px); line-height: 1.7; color: var(--ea-body); }
  .epc-rte > :first-child { margin-top: 0; } .epc-rte > :last-child { margin-bottom: 0; }
  .epc-rte p { max-width: 68ch; margin: 0 auto clamp(20px,2.2vw,28px); font-weight: 400; letter-spacing: 0.002em; }
  .epc-rte h2 { max-width: 30ch; margin: clamp(52px,6.5vw,92px) auto clamp(14px,1.6vw,20px); font-family: var(--ep-serif);
    font-style: italic; font-weight: 400; font-size: clamp(28px,3.6vw,46px); line-height: 1.12; letter-spacing: -0.012em; color: var(--ea-ink); text-wrap: balance; }
  .epc-rte h3 { max-width: 56ch; margin: clamp(40px,5vw,68px) auto clamp(10px,1.2vw,14px); font-family: var(--ep-sans);
    font-weight: 500; font-size: clamp(11px,0.5vw + 9px,12.5px); line-height: 1.6; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ea-champ); }
  .epc-rte h4, .epc-rte h5, .epc-rte h6 { max-width: 56ch; margin: clamp(34px,4vw,54px) auto clamp(8px,1vw,12px);
    font-family: var(--ep-serif); font-weight: 400; font-size: clamp(21px,2.2vw,28px); line-height: 1.2; color: var(--ea-ink); }
  .epc-rte h2 + p, .epc-rte h3 + p, .epc-rte h4 + p { margin-top: 0; }
  .epc-rte strong, .epc-rte b { color: rgba(255,255,255,0.94); font-weight: 600; }
  .epc-rte em, .epc-rte i { font-style: italic; }
  .epc-rte a { color: var(--ea-ink); text-decoration: none;
    background-image: linear-gradient(var(--ea-hair-champ), var(--ea-hair-champ)); background-repeat: no-repeat;
    background-position: 0 100%; background-size: 100% 1px; transition: color 240ms ease, background-size 240ms ease; }
  .epc-rte a:hover { color: var(--ea-champ); background-size: 100% 1.5px; }
  .epc-rte ul, .epc-rte ol { max-width: 64ch; margin: 0 auto clamp(20px,2.2vw,28px); padding: 0; list-style: none; }
  .epc-rte ul li, .epc-rte ol li { position: relative; padding-left: 28px; line-height: 1.7; }
  .epc-rte ul li + li, .epc-rte ol li + li { margin-top: clamp(10px,1.2vw,15px); }
  .epc-rte ul li::before { content: ""; position: absolute; left: 3px; top: 0.78em; width: 4px; height: 4px; transform: rotate(45deg); background: rgba(233,215,177,0.55); }
  .epc-rte ol { counter-reset: ea-ol; } .epc-rte ol li { counter-increment: ea-ol; padding-left: 36px; }
  .epc-rte ol li::before { content: counter(ea-ol, decimal-leading-zero); position: absolute; left: 0; top: 0.06em;
    font-family: var(--ep-serif); font-size: 0.92em; color: rgba(233,215,177,0.78); font-feature-settings: "tnum" 1; }
  .epc-rte blockquote { position: relative; max-width: 34ch; margin: clamp(48px,7vw,96px) auto !important;
    padding: clamp(8px,1.4vw,16px) 0 clamp(8px,1.4vw,16px) clamp(26px,4vw,48px); border-left: 1px solid var(--ea-hair-champ);
    font-family: var(--ep-serif); font-style: italic; font-weight: 400; font-size: clamp(24px,3.4vw,40px); line-height: 1.3; color: rgba(255,255,255,0.90); text-wrap: pretty; }
  .epc-rte blockquote::before { content: "\201C"; position: absolute; left: clamp(12px,1.8vw,26px); top: -0.42em;
    font-family: var(--ep-serif); font-style: normal; font-size: clamp(56px,8vw,112px); line-height: 1; color: rgba(233,215,177,0.16); pointer-events: none; }
  .epc-rte blockquote p { max-width: none; margin: 0; color: inherit; font-size: inherit; }
  .epc-rte hr { position: relative; width: min(100%, 420px); height: 1px; border: 0; margin: clamp(48px,7vw,96px) auto !important; overflow: visible;
    background: linear-gradient(90deg, transparent, var(--ea-hair) 22%, var(--ea-hair) 78%, transparent); }
  .epc-rte hr::before { content: ""; position: absolute; top: 50%; left: 50%; width: 5px; height: 5px; transform: translate(-50%,-50%) rotate(45deg); background: var(--ea-champ); opacity: 0.55; }
  .epc-rte img { display: block; max-width: 100%; height: auto; margin: clamp(36px,5vw,64px) auto; border-radius: 14px; box-shadow: 0 20px 60px rgba(5,22,19,0.45), inset 0 0 0 1px rgba(255,255,255,0.06); }

  /* ── Pie: compartir + volver ── */
  .eart-foot { max-width: 68ch; margin: clamp(48px,7vw,88px) auto 0; padding-top: clamp(26px,3.4vw,40px);
    border-top: 1px solid var(--ea-hair); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .eart-share { display: inline-flex; align-items: center; gap: 14px; }
  .eart-share__label { font-family: var(--ep-sans); font-size: 10px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .eart-share__btn { display: inline-flex; align-items: center; gap: 8px; appearance: none; -webkit-appearance: none; cursor: pointer;
    background: transparent; border: 0; padding: 5px 0; border-bottom: 1px solid var(--ea-hair-champ);
    font-family: var(--ep-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ea-champ);
    transition: color 240ms ease, border-color 240ms ease; }
  .eart-share__btn:hover { color: #fff; border-color: rgba(233,215,177,0.55); }
  .eart-back { display: inline-flex; align-items: center; gap: 9px; font-family: var(--ep-sans); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.22em; text-transform: uppercase; color: rgba(233,215,177,0.85); text-decoration: none; transition: color 240ms ease; }
  .eart-back svg { transition: transform 240ms cubic-bezier(0.2,0,0,1); }
  .eart-back:hover { color: var(--ea-champ); } .eart-back:hover svg { transform: translateX(-4px); }

  /* ── Comentarios ── */
  .eart-comments { max-width: var(--ea-measure); margin: clamp(56px,8vw,104px) auto 0; }
  .eart-comments__title { margin: 0 0 clamp(24px,3vw,36px); font-family: var(--ep-serif); font-style: italic; font-weight: 400;
    font-size: clamp(26px,3vw,38px); color: var(--ea-ink); }
  .eart-comment { padding: clamp(20px,2.4vw,28px) 0; border-top: 1px solid var(--ea-hair); }
  .eart-comment:first-child { border-top: 0; }
  .eart-comment__body { font-family: var(--ep-sans); font-size: 15px; line-height: 1.7; color: var(--ea-body); }
  .eart-comment__body p { margin: 0 0 10px; } .eart-comment__body :last-child { margin-bottom: 0; }
  .eart-comment__meta { display: flex; align-items: center; gap: 11px; margin-top: 12px; font-family: var(--ep-sans);
    font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .eart-comment__meta .eart-meta__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ea-champ); opacity: 0.6; }
  .eart-comments__pager { display: flex; justify-content: center; gap: 10px; margin-top: clamp(28px,4vw,44px); }
  .eart-comments__pager a, .eart-comments__pager span { min-width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--ep-sans); font-size: 12px; color: rgba(255,255,255,0.55); text-decoration: none; border: 1px solid var(--ea-hair); }
  .eart-comments__pager a:hover { color: #fff; border-color: var(--ea-hair-champ); }
  .eart-comments__pager .pagination__item--current, .eart-comments__pager [aria-current] { color: #0A2620; background: var(--ea-champ); border-color: var(--ea-champ); }

  /* ── Form de comentario (maquinaria .econt re-piel) ── */
  .eart-form-wrap { margin-top: clamp(40px,5vw,64px); }
  .eart-form-title { margin: 0 0 clamp(22px,2.6vw,32px); font-family: var(--ep-serif); font-style: italic; font-weight: 400;
    font-size: clamp(24px,2.6vw,32px); color: var(--ea-ink); }
  .econt__panel { position: relative; border-radius: 18px; padding: clamp(28px,3.4vw,44px);
    background: linear-gradient(180deg, rgba(20,60,50,0.30), rgba(11,36,29,0.30)); box-shadow: 0 20px 60px rgba(5,22,19,0.45), inset 0 0 0 1px rgba(255,255,255,0.06); }
  .econt__form { display: grid; gap: clamp(20px,2.2vw,28px); }
  .econt__row { display: grid; gap: clamp(20px,2.2vw,28px); }
  @container eart-panel (min-width: 560px) { .econt__row { grid-template-columns: 1fr 1fr; } }
  .econt__field { position: relative; }
  .econt__field .field__input { width: 100%; display: block; margin: 0; appearance: none; -webkit-appearance: none;
    background: var(--ea-field-bg); border: 1px solid var(--ea-field-line); border-radius: 0; color: var(--ea-ink);
    font-family: var(--ep-sans); font-size: 16px; line-height: 1.4; padding: 26px 18px 10px; min-height: 58px;
    transition: border-color 240ms ease, background 240ms ease; }
  .econt__field textarea.field__input { min-height: 168px; resize: vertical; line-height: 1.6; padding-top: 28px; }
  .econt__field .field__input::placeholder { color: transparent; }
  .econt__field .field__input:hover { border-color: rgba(255,255,255,0.3); }
  .econt__field .field__input:focus { outline: none; border-color: var(--ea-champ); background: var(--ea-field-bg-focus); }
  .econt__field .field__input:-webkit-autofill, .econt__field .field__input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--ea-ink); -webkit-box-shadow: 0 0 0 1000px #0C2C24 inset; caret-color: var(--ea-ink); }
  .econt__field .field__label { position: absolute; left: 18px; top: 18px; margin: 0; font-family: var(--ep-sans);
    font-size: 15px; font-weight: 400; color: rgba(255,255,255,0.5); pointer-events: none; transform-origin: left top;
    transition: transform 200ms ease, color 200ms ease; }
  .econt__field .field__input:focus + .field__label, .econt__field .field__input:not(:placeholder-shown) + .field__label {
    transform: translateY(-10px) scale(0.72); letter-spacing: 0.22em; text-transform: uppercase; }
  .econt__field .field__input:focus + .field__label { color: var(--ea-champ); }
  .econt__field .field__label span { text-transform: none; letter-spacing: 0; color: var(--ea-bronze); }
  .econt__field--error .field__input { border-color: var(--ea-bronze); }
  .econt__field-error { display: block; margin: 8px 0 0; font-family: var(--ep-sans); font-size: 12px; line-height: 1.5; color: var(--ea-bronze); }
  .econt__field-error .svg-wrapper { display: none; } .econt__field-error .form__message { display: inline; }
  .econt__submit { justify-self: start; margin-top: clamp(6px,1vw,12px); }
  .econt__submit .button, .eart-form-wrap input[type="submit"].button { display: inline-flex; align-items: center; gap: 12px;
    appearance: none; -webkit-appearance: none; cursor: pointer; border: 0; border-radius: 0; padding: 18px 44px;
    background: linear-gradient(180deg, #E9D7B1, #C9A66B); color: #0A2620; font-family: var(--ep-sans); font-size: 11px;
    font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; box-shadow: 0 0 30px rgba(233,215,177,0.25);
    transition: box-shadow 360ms ease; }
  .eart-form-wrap input[type="submit"].button:hover { box-shadow: 0 0 46px rgba(233,215,177,0.42); }
  .econt__success { display: flex; align-items: flex-start; gap: 16px; margin: 0 0 clamp(24px,3vw,34px); padding: 22px 24px; border-radius: 12px;
    background: rgba(125,255,178,0.08); border: 1px solid rgba(125,255,178,0.32); }
  .econt__success .svg-wrapper { display: none; }
  .econt__success-text { margin: 0; font-family: var(--ep-sans); font-size: 15px; line-height: 1.55; color: rgba(246,242,232,0.92); }
  .econt__error-summary { margin: 0 0 clamp(24px,3vw,34px); padding: 20px 24px; border-radius: 12px;
    background: rgba(217,119,87,0.08); border: 1px solid rgba(217,119,87,0.32); }
  .econt__error-summary h3, .econt__error-summary .form-status { display: flex; align-items: center; gap: 10px; margin: 0;
    font-family: var(--ep-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ea-bronze); }
  .econt__error-summary .svg-wrapper { display: none; }
  .econt__error-list { margin: 12px 0 0; padding: 0; list-style: none; }
  .econt__error-list li { font-family: var(--ep-sans); font-size: 14px; line-height: 1.6; }
  .econt__error-list a { color: rgba(246,242,232,0.9); text-decoration: none; border-bottom: 1px solid var(--ea-bronze); }
  .eart-moderated { margin: 14px 0 0; font-family: var(--ep-sans); font-size: 12px; letter-spacing: 0.02em; color: var(--ea-body-soft); }

  .eart-head, .epc-rte { opacity: 0; transform: translateY(16px); animation: eart-rise 800ms cubic-bezier(0.05,0.7,0.1,1) both; }
  .epc-rte { animation-delay: 120ms; }
  @keyframes eart-rise { to { opacity: 1; transform: none; } }
  @media (max-width: 720px) {
    .eart { padding: clamp(40px,12vw,72px) 22px clamp(56px,14vw,80px); }
    .epc-rte { font-size: 16px; } .epc-rte p, .epc-rte ul, .epc-rte ol { max-width: none; }
    .eart-title { font-size: clamp(32px,10vw,52px); } .epc-rte h2 { font-size: clamp(26px,8vw,38px); max-width: none; }
    .epc-rte blockquote { font-size: clamp(22px,7vw,30px); max-width: none; padding-left: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .eart-head, .epc-rte { opacity: 1; transform: none; animation: none; } }
</style>

<section class="eart">
  <article class="eart-inner">
    <header class="eart-head">
      {%- if blog.url != blank -%}
        <a class="eart-back-top" href="{{ blog.url }}">{% if is_en %}{{ blog.title | default: 'Journal' }}{% else %}{{ blog.title | default: 'Diario' }}{% endif %}</a>
      {%- endif -%}
      <h1 class="eart-title">{{ article.title | escape }}</h1>
      <div class="eart-meta">
        {%- if section.settings.show_date -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {%- if is_en -%}{{ article.published_at | date: '%B %-d, %Y' }}{%- else -%}{{ article.published_at | date: '%-d %B %Y' }}{%- endif -%}
          </time>
        {%- endif -%}
        {%- if section.settings.show_author and article.author != blank -%}
          {%- if section.settings.show_date -%}<span class="eart-meta__dot" aria-hidden="true"></span>{%- endif -%}
          <span>{{ article.author }}</span>
        {%- endif -%}
      </div>
    </header>

    {%- if article.image -%}
      <div class="eart-hero">
        <img
          srcset="{{ article.image | image_url: width: 750 }} 750w, {{ article.image | image_url: width: 1100 }} 1100w, {{ article.image | image_url: width: 1500 }} 1500w"
          sizes="(min-width: 760px) 720px, 100vw"
          src="{{ article.image | image_url: width: 1100 }}"
          loading="eager" fetchpriority="high"
          width="{{ article.image.width }}" height="{{ article.image.height }}"
          alt="{{ article.image.alt | escape }}">
      </div>
    {%- endif -%}

    {%- if article.content != blank -%}
      <div class="epc-rte rte">{{ article.content }}</div>
    {%- endif -%}

    <div class="eart-foot">
      {%- assign share_url = request.origin | append: article.url -%}
      <div class="eart-share">
        <span class="eart-share__label">{% if is_en %}Share{% else %}Compartir{% endif %}</span>
        <button type="button" class="eart-share__btn" data-share-url="{{ share_url }}" data-copied="{% if is_en %}Link copied{% else %}Enlace copiado{% endif %}">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 10l4-4M6.5 4.5l1-1a2.5 2.5 0 013.5 3.5l-1 1M9.5 11.5l-1 1a2.5 2.5 0 01-3.5-3.5l1-1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          <span class="eart-share__txt">{% if is_en %}Copy link{% else %}Copiar enlace{% endif %}</span>
        </button>
      </div>
      <a class="eart-back" href="{{ blog.url }}">
        <svg width="13" height="9" viewBox="0 0 13 9" fill="none" aria-hidden="true"><path d="M12 4.5H2M5.5 1L2 4.5 5.5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {% if is_en %}All stories{% else %}Todos los relatos{% endif %}
      </a>
    </div>

    {%- if blog.comments_enabled? -%}
      <div class="eart-comments" id="comments">
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}
          <h2 class="eart-comments__title" id="Comments-{{ article.id }}" tabindex="-1">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
          {% paginate article.comments by 5 %}
            {%- if comment.status == 'pending' and comment.content -%}
              <article id="{{ comment.id }}" class="eart-comment">
                <div class="eart-comment__body">{{ comment.content }}</div>
                <div class="eart-comment__meta"><span>{{ comment.author }}</span></div>
              </article>
            {%- endif -%}
            {%- for comment in article.comments -%}
              <article id="{{ comment.id }}" class="eart-comment">
                <div class="eart-comment__body">{{ comment.content }}</div>
                <div class="eart-comment__meta">
                  <span>{{ comment.author }}</span><span class="eart-meta__dot" aria-hidden="true"></span><span>{{ comment.created_at | date: '%-d %b %Y' }}</span>
                </div>
              </article>
            {%- endfor -%}
            {%- if paginate.pages > 1 -%}
              <nav class="eart-comments__pager" role="navigation" aria-label="{% if is_en %}Comments pagination{% else %}Paginación de comentarios{% endif %}">
                {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}{{ anchorId }}">←</a>{%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}<a href="{{ part.url }}{{ anchorId }}">{{ part.title }}</a>
                  {%- else -%}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}<a href="{{ paginate.next.url }}{{ anchorId }}">→</a>{%- endif -%}
              </nav>
            {%- endif -%}
          {% endpaginate %}
        {%- endif -%}

        <div class="eart-form-wrap">
          {% form 'new_comment', article %}
            {%- liquid
              assign post_message = 'blogs.article.success'
              if blog.moderated? and comment.status == 'unapproved'
                assign post_message = 'blogs.article.success_moderated'
              endif
            -%}
            <h2 class="eart-form-title">{{ 'blogs.article.comment_form_title' | t }}</h2>
            {%- if form.errors -%}
              <div class="econt__error-summary">
                <h3 class="form-status" role="alert" tabindex="-1" autofocus>{% if is_en %}Please adjust the following{% else %}Por favor, ajusta lo siguiente{% endif %}</h3>
                <ul class="econt__error-list" role="list">
                  {%- for field in form.errors -%}
                    <li><a href="#CommentForm-{{ field }}">
                      {%- if form.errors.translated_fields[field] contains 'author' -%}{{ 'blogs.article.name' | t }}
                      {%- elsif form.errors.translated_fields[field] contains 'body' -%}{{ 'blogs.article.message' | t }}
                      {%- else -%}{{ form.errors.translated_fields[field] }}{%- endif -%}
                      {{ form.errors.messages[field] }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- elsif form.posted_successfully? -%}
              <div class="econt__success" role="status" tabindex="-1" autofocus>
                <p class="econt__success-text">{{ post_message | t }}</p>
              </div>
            {%- endif -%}

            <div class="econt__panel" style="container: eart-panel / inline-size;">
              <div class="econt__form">
                <div class="econt__row">
                  <div class="econt__field{% if form.errors contains 'author' %} econt__field--error{% endif %}">
                    <input type="text" name="comment[author]" id="CommentForm-author" class="field__input" autocomplete="name"
                      value="{{ form.author }}" aria-required="true" required
                      {% if form.errors contains 'author' %}aria-invalid="true" aria-describedby="CommentForm-author-error"{% endif %}
                      placeholder="{{ 'blogs.article.name' | t }}">
                    <label class="field__label" for="CommentForm-author">{% if is_en %}Name{% else %}Nombre{% endif %}<span aria-hidden="true">*</span></label>
                    {%- if form.errors contains 'author' -%}<small class="econt__field-error" id="CommentForm-author-error">{{ 'blogs.article.name' | t }} {{ form.errors.messages.author }}.</small>{%- endif -%}
                  </div>
                  <div class="econt__field{% if form.errors contains 'email' %} econt__field--error{% endif %}">
                    <input type="email" name="comment[email]" id="CommentForm-email" class="field__input" autocomplete="email"
                      value="{{ form.email }}" autocorrect="off" autocapitalize="off" aria-required="true" required
                      {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="CommentForm-email-error"{% endif %}
                      placeholder="{{ 'blogs.article.email' | t }}">
                    <label class="field__label" for="CommentForm-email">{% if is_en %}Email{% else %}Correo{% endif %}<span aria-hidden="true">*</span></label>
                    {%- if form.errors contains 'email' -%}<small class="econt__field-error" id="CommentForm-email-error">{{ 'blogs.article.email' | t }} {{ form.errors.messages.email }}.</small>{%- endif -%}
                  </div>
                </div>
                <div class="econt__field">
                  <textarea rows="6" name="comment[body]" id="CommentForm-body" class="text-area field__input" aria-required="true" required
                    {% if form.errors contains 'body' %}aria-invalid="true" aria-describedby="CommentForm-body-error"{% endif %}
                    placeholder="{{ 'blogs.article.message' | t }}">{{- form.body -}}</textarea>
                  <label class="field__label" for="CommentForm-body">{% if is_en %}Message{% else %}Mensaje{% endif %}<span aria-hidden="true">*</span></label>
                  {%- if form.errors contains 'body' -%}<small class="econt__field-error" id="CommentForm-body-error">{{ 'blogs.article.message' | t }} {{ form.errors.messages.body }}.</small>{%- endif -%}
                </div>
                {%- if blog.moderated? -%}<p class="eart-moderated">{{ 'blogs.article.moderated' | t }}</p>{%- endif -%}
                <div class="econt__submit"><input type="submit" class="button" value="{% if is_en %}Post{% else %}Publicar{% endif %}"></div>
              </div>
            </div>
          {% endform %}
        </div>
      </div>
    {%- endif -%}
  </article>
</section>

<script>
  (function () {
    document.querySelectorAll('.eart-share__btn').forEach(function (b) {
      b.addEventListener('click', function () {
        var url = b.getAttribute('data-share-url');
        if (navigator.share) { navigator.share({ url: url }).catch(function () {}); return; }
        var txt = b.querySelector('.eart-share__txt');
        var done = function () { if (!txt) return; var o = txt.textContent; txt.textContent = b.getAttribute('data-copied'); setTimeout(function () { txt.textContent = o; }, 1800); };
        if (navigator.clipboard) { navigator.clipboard.writeText(url).then(done).catch(function () {}); }
      });
    });
  })();
</script>

<script type="application/ld+json">
{{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Artículo ELYXIE",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_date", "label": "Mostrar fecha", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Mostrar autor", "default": false }
  ],
  "presets": [{ "name": "Artículo ELYXIE" }]
}
{% endschema %}
