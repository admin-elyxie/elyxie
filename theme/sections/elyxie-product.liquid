{%- comment -%}
  Página de producto ELYXIE — bespoke, en el vibe de la landing (emerald, Cormorant,
  champagne). Selector de cadena idéntico a la Vitrina (glifos SVG fine/curb, orden
  ella→él) + precio en vivo + buy-now (Cart AJAX). Borde redondeado (no la esquina
  viva de la Vitrina) por pedido.
{%- endcomment -%}
{%- assign tparts = product.title | split: '·' -%}
{%- assign tname = tparts[0] | strip -%}
{%- assign tfinish = tparts[1] | strip | default: '' -%}
{%- comment -%} detección por SKU (…-ELLA / …-EL), independiente del idioma (la variante se traduce) {%- endcomment -%}
{%- for v in product.variants -%}
  {%- if v.sku contains 'ELLA' -%}{%- assign v_ella = v -%}{%- else -%}{%- assign v_el = v -%}{%- endif -%}
{%- endfor -%}
{%- assign v_default = v_ella | default: product.variants.first -%}
{%- assign is_en = false -%}{%- if request.locale.iso_code == 'en' -%}{%- assign is_en = true -%}{%- endif -%}

<style>
  .eprod { padding: clamp(8px,2vw,32px) clamp(20px,5vw,64px) clamp(56px,7vw,112px); }
  .eprod__wrap { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(28px,4vw,72px); align-items: start; max-width: 1240px; margin: 0 auto; }
  .eprod__media { position: relative; }
  .eprod__panel { position: relative; border-radius: 18px; overflow: hidden;
    box-shadow: 0 20px 60px rgba(5,22,19,0.55), inset 0 0 0 1px rgba(255,255,255,0.06); background: #0E2E26; }
  .eprod__panel img { display: block; width: 100%; height: auto; aspect-ratio: 1/1; object-fit: cover; }
  .eprod__chip { position: absolute; top: 16px; left: 16px; z-index: 2; padding: 8px 14px;
    background: rgba(5,22,19,0.55); backdrop-filter: blur(6px); border: 1px solid rgba(233,215,177,0.28);
    color: var(--ep-champ); font-size: 10px; letter-spacing: 0.26em; }
  .eprod__thumbs { display: flex; gap: 12px; margin-top: 16px; }
  .eprod__thumb { width: 76px; height: 76px; border-radius: 10px; overflow: hidden; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1); opacity: 0.55; transition: opacity 220ms ease, border-color 220ms ease; background:#0E2E26; padding:0; }
  .eprod__thumb[data-on] { opacity: 1; border-color: var(--ep-champ); }
  .eprod__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .eprod__eyebrow { font-size: 11px; letter-spacing: 0.32em; color: var(--ep-champ); text-transform: uppercase; }
  .eprod__title { font-family: var(--ep-serif); font-weight: 400; font-size: clamp(40px,5vw,68px);
    line-height: 1.02; letter-spacing: -0.01em; margin: 18px 0 0; }
  .eprod__title em { font-style: italic; color: var(--ep-champ); }
  .eprod__desc { margin: 22px 0 0; max-width: 46ch; color: rgba(255,255,255,0.74); font-size: 16px; line-height: 1.7; }
  .eprod__desc p { margin: 0; }

  /* ── Chain selector — replica exacta de la Vitrina (glifo + nombre + spec) ── */
  .eprod__chainLabel { display: block; margin: 34px 0 13px; font-family: var(--ep-sans);
    font-size: 10px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(255,255,255,0.56); }
  .eprod__chains { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
  .eprod__chainOpt { display: flex; align-items: center; gap: 13px; padding: 15px 16px; text-align: left; cursor: pointer;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; /* redondeado (por pedido) */
    transition: border-color 280ms cubic-bezier(0.2,0,0,1), background 280ms cubic-bezier(0.2,0,0,1), box-shadow 280ms cubic-bezier(0.2,0,0,1);
    color: #fff; font-family: var(--ep-sans); }
  .eprod__chainOpt:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); }
  .eprod__chainOpt[data-on] { border-color: var(--ep-champ);
    background: color-mix(in srgb, var(--ep-champ) 8%, transparent); box-shadow: 0 0 22px rgba(233,215,177,0.10); }
  .eprod__chainGlyph { flex: none; display: flex; color: rgba(255,255,255,0.5); transition: color 280ms cubic-bezier(0.2,0,0,1); }
  .eprod__chainOpt[data-on] .eprod__chainGlyph { color: var(--ep-champ); }
  .eprod__chainText { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .eprod__chainName { font-family: var(--ep-sans); font-size: 14px; font-weight: 500; letter-spacing: 0.01em;
    color: rgba(255,255,255,0.72); transition: color 280ms cubic-bezier(0.2,0,0,1); }
  .eprod__chainOpt[data-on] .eprod__chainName { color: #fff; }
  .eprod__chainSpec { font-family: var(--ep-sans); font-size: 11px; letter-spacing: 0.02em;
    color: rgba(255,255,255,0.55); font-variant-numeric: tabular-nums; }

  .eprod__note { margin-top: 12px; font-size: 12px; color: rgba(255,255,255,0.45); }
  .eprod__price { margin: 30px 0 4px; font-family: var(--ep-serif); font-size: clamp(34px,4vw,52px); color: #fff; }
  .eprod__meta { font-size: 11px; letter-spacing: 0.22em; color: rgba(255,255,255,0.5); }
  .eprod-buy { margin-top: 26px; display: inline-flex; align-items: center; gap: 14px;
    padding: 18px 34px; border: 0; cursor: pointer; border-radius: 0;
    background: linear-gradient(180deg, #E9D7B1, #C9A66B); color: #0A2620;
    font-family: var(--ep-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase;
    box-shadow: 0 0 30px rgba(233,215,177,0.25); transition: box-shadow 240ms ease, opacity 220ms ease; }
  .eprod-buy:hover { box-shadow: 0 0 60px rgba(233,215,177,0.35), 0 0 120px rgba(233,215,177,0.18); }
  .eprod-form { display: block; }
  .eprod-buy[data-busy], .eprod-buy.loading, .eprod-buy[aria-disabled="true"] { pointer-events: none; opacity: 0.7; }
  .eprod-buy[disabled] { pointer-events: none; opacity: 0.5; }
  .eprod-buy .loading__spinner { display: none; }
  .eprod-buy__arrow { display: inline-block; transition: transform 220ms cubic-bezier(0.2,0,0,1); }
  .eprod-buy:hover .eprod-buy__arrow { transform: translateX(5px); }
  .eprod-buy__err { margin-top: 14px; color: #E5A3A3; font-size: 12px; letter-spacing: 0.04em; }
  @media (max-width: 860px){ .eprod__wrap { grid-template-columns: 1fr; } .eprod__chains { grid-template-columns: 1fr; } }

  /* ── Historia editorial (descripción larga del producto) ──────────────────
     Dirección "Editorial Minimal — revista de lujo" (workflow diseño+juez):
     champagne con cuentagotas, jerarquía por tamaño/peso, centrado estrecho.
     Injertos: ficha = registro de catálogo (hairlines indep. del fondo);
     hilo champagne de apertura que cose con el hero; rombo del hr sin halo. */
  .estory {
    --es-measure: 760px; --es-measure-wide: 940px;
    --es-ink: #FFFFFF; --es-body: rgba(255,255,255,0.76); --es-body-soft: rgba(255,255,255,0.62);
    --es-champ: var(--ep-champ); --es-gold: var(--ep-gold);
    --es-hair: rgba(255,255,255,0.10); --es-hair-faint: rgba(255,255,255,0.07);
    --es-serif: var(--ep-serif); --es-sans: var(--ep-sans);
    position: relative; width: 100%;
    padding: clamp(80px,12vw,176px) 24px clamp(72px,11vw,148px);
    color: var(--es-body); font-family: var(--es-sans);
    font-size: clamp(16px, 1.05vw + 13px, 18px); line-height: 1.72;
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  /* hilo champagne de apertura — cose la historia con el hero de arriba */
  .estory::before { content: ""; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: clamp(120px,22vw,280px); height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ep-champ) 55%, transparent), transparent); }
  .estory-inner { max-width: var(--es-measure); margin: 0 auto; }
  .estory-inner > * { margin: 0; }
  .estory-inner > * + * { margin-top: clamp(20px,2.4vw,30px); }
  .estory p { max-width: 68ch; margin-left: auto; margin-right: auto; color: var(--es-body); font-weight: 400; letter-spacing: 0.002em; }
  .estory strong { color: rgba(255,255,255,0.92); font-weight: 600; }
  .estory-title { font-family: var(--es-serif); font-weight: 300; font-size: clamp(40px,6vw,78px); line-height: 1.02; letter-spacing: -0.02em; text-align: center; color: var(--es-ink); max-width: 16ch; margin-left: auto; margin-right: auto; }
  .estory-sub { font-family: var(--es-serif); font-style: italic; font-weight: 400; font-size: clamp(20px,2.6vw,30px); line-height: 1.25; letter-spacing: 0.005em; text-align: center; color: var(--es-champ); opacity: 0.82; margin-top: clamp(14px,1.6vw,20px) !important; }
  .estory-sub + p { margin-top: clamp(40px,5vw,68px) !important; }
  .estory-accent { max-width: 24ch; margin: clamp(40px,5vw,64px) auto !important; font-family: var(--es-serif); font-style: italic; font-weight: 400; font-size: clamp(24px,3.4vw,38px); line-height: 1.28; letter-spacing: -0.005em; text-align: center; color: rgba(255,255,255,0.90); text-wrap: balance; }
  .estory h3 { max-width: 32ch; margin-left: auto; margin-right: auto; margin-top: clamp(48px,6vw,88px) !important; margin-bottom: clamp(2px,0.6vw,6px); font-family: var(--es-sans); font-weight: 500; font-size: clamp(11px, 0.5vw + 9px, 12.5px); line-height: 1.6; letter-spacing: 0.28em; text-transform: uppercase; text-align: center; color: var(--es-champ); }
  .estory h3 + p { margin-top: clamp(12px,1.4vw,18px) !important; text-align: center; }
  .estory hr { position: relative; width: min(100%, 420px); height: 1px; border: 0; margin: clamp(56px,7vw,104px) auto !important; background: linear-gradient(90deg, transparent, var(--es-hair) 22%, var(--es-hair) 78%, transparent); overflow: visible; }
  .estory hr::before { content: ""; position: absolute; top: 50%; left: 50%; width: 5px; height: 5px; transform: translate(-50%,-50%) rotate(45deg); background: var(--es-champ); opacity: 0.55; }
  .estory-chapters { list-style: none; counter-reset: estory-ch; max-width: var(--es-measure-wide); margin-left: auto; margin-right: auto; padding: 0; }
  .estory-chapters > li { counter-increment: estory-ch; position: relative; padding-left: clamp(78px,11vw,132px); min-height: clamp(64px,8vw,96px); }
  .estory-chapters > li + li { margin-top: clamp(48px,6vw,84px); padding-top: clamp(48px,6vw,84px); border-top: 1px solid var(--es-hair-faint); }
  .estory-chapters > li::before { content: counter(estory-ch, decimal-leading-zero); position: absolute; left: 0; top: -0.12em; font-family: var(--es-serif); font-weight: 300; font-size: clamp(54px,8vw,104px); line-height: 1; letter-spacing: -0.03em; color: rgba(233,215,177,0.22); font-feature-settings: "tnum" 1; pointer-events: none; }
  .estory-chapters h4 { margin: 0 0 clamp(14px,1.6vw,20px); font-family: var(--es-serif); font-weight: 400; font-size: clamp(25px,3vw,38px); line-height: 1.16; letter-spacing: -0.01em; color: var(--es-ink); text-wrap: balance; }
  .estory-chapters > li > p { max-width: 64ch; margin: 0; text-align: left; }
  .estory-chapters ul { list-style: none; margin: clamp(20px,2.4vw,30px) 0 0; padding: 0; }
  .estory-chapters ul li { position: relative; padding-left: 26px; max-width: 62ch; color: var(--es-body); }
  .estory-chapters ul li + li { margin-top: clamp(12px,1.4vw,18px); }
  .estory-chapters ul li::before { content: ""; position: absolute; left: 2px; top: 0.82em; width: 4px; height: 4px; transform: rotate(45deg); background: rgba(233,215,177,0.55); }
  .estory-chapters ul em { font-style: normal; font-weight: 500; letter-spacing: 0.01em; color: var(--es-champ); }
  .estory-detail-h { margin-bottom: clamp(28px,3.4vw,44px) !important; }
  /* Ficha técnica — registro de catálogo (injerto Dir. 3): hairlines independientes del fondo */
  .estory-spec { max-width: 720px; margin: 0 auto; padding: 0; border-top: 1px solid var(--es-hair); }
  .estory-spec > div { display: grid; grid-template-columns: minmax(140px,0.42fr) 1fr; gap: clamp(16px,3vw,40px); align-items: baseline; padding: clamp(16px,2vw,22px) clamp(4px,1vw,14px); border-bottom: 1px solid var(--es-hair); }
  .estory-spec dt { margin: 0; font-family: var(--es-sans); font-weight: 500; font-size: clamp(10px,0.9vw,11.5px); letter-spacing: 0.22em; text-transform: uppercase; color: var(--es-champ); line-height: 1.55; }
  .estory-spec dd { margin: 0; font-family: var(--es-serif); font-weight: 400; font-size: clamp(17px,1.7vw,21px); line-height: 1.45; letter-spacing: 0.004em; color: rgba(255,255,255,0.9); }
  .estory blockquote { position: relative; max-width: 30ch; margin: clamp(64px,9vw,128px) auto !important; padding: clamp(8px,1.4vw,16px) 0 clamp(8px,1.4vw,16px) clamp(28px,4vw,52px); border-left: 1px solid rgba(233,215,177,0.40); font-family: var(--es-serif); font-style: italic; font-weight: 400; font-size: clamp(26px,3.8vw,44px); line-height: 1.30; letter-spacing: -0.01em; color: rgba(255,255,255,0.88); text-wrap: pretty; }
  .estory blockquote::before { content: "\201C"; position: absolute; left: clamp(14px,2vw,28px); top: -0.42em; font-family: var(--es-serif); font-style: normal; font-size: clamp(64px,9vw,128px); line-height: 1; color: rgba(233,215,177,0.16); pointer-events: none; user-select: none; }
  .estory-close { max-width: 38ch; margin: clamp(56px,7vw,104px) auto 0 !important; font-family: var(--es-sans); font-weight: 400; font-size: clamp(15px, 1vw + 12px, 17px); line-height: 1.7; letter-spacing: 0.06em; text-align: center; color: var(--es-body-soft); }
  @media (max-width: 720px){
    .estory { padding: clamp(64px,16vw,96px) 22px clamp(56px,14vw,80px); font-size: 16px; line-height: 1.68; }
    .estory-inner > * + * { margin-top: 18px; }
    .estory p { max-width: none; }
    .estory-title { font-size: clamp(34px,11vw,52px); max-width: 18ch; }
    .estory-sub { font-size: clamp(19px,5.4vw,25px); }
    .estory-accent { font-size: clamp(22px,6.4vw,30px); max-width: 22ch; }
    .estory h3 { margin-top: 44px !important; max-width: none; }
    .estory hr { margin: 48px auto !important; width: 100%; }
    .estory-chapters > li { padding-left: 0; padding-top: 0; min-height: 0; }
    .estory-chapters > li + li { margin-top: 40px; padding-top: 40px; }
    .estory-chapters > li::before { position: static; display: block; font-size: clamp(46px,16vw,64px); margin-bottom: 4px; }
    .estory-chapters h4 { font-size: clamp(22px,6.4vw,30px); }
    .estory-chapters > li > p, .estory-chapters ul li { max-width: none; }
    .estory-spec > div { grid-template-columns: 1fr; gap: 6px; padding: 16px 2px; }
    .estory-spec dt { letter-spacing: 0.2em; }
    .estory-spec dd { font-size: 18px; }
    .estory blockquote { font-size: clamp(23px,7vw,32px); padding-left: 22px; max-width: none; margin: 64px auto !important; }
    .estory blockquote::before { font-size: clamp(56px,18vw,80px); }
    .estory-close { max-width: none; }
  }
  @media (max-width: 480px){
    .estory { padding: 56px 18px 52px; }
    .estory-title { font-size: clamp(30px,12vw,42px); }
    .estory-sub { font-size: 19px; }
    .estory-accent { font-size: 22px; }
    .estory h3 { letter-spacing: 0.24em; }
    .estory-chapters > li::before { font-size: 44px; }
    .estory-chapters h4 { font-size: 23px; }
    .estory blockquote { font-size: 23px; }
  }
</style>

<section class="eprod">
  <div class="eprod__wrap">
    <div class="eprod__media">
      <div class="eprod__panel">
        <span class="eprod__chip">{% if is_en %}LIMITED EDITION · No. 01 / 100{% else %}EDICIÓN LIMITADA · N.º 01 / 100{% endif %}</span>
        <img class="eprod-img" src="{{ v_default.image | default: product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="600" height="600"/>
      </div>
      {%- if product.variants.size > 1 -%}
      <div class="eprod__thumbs">
        {%- if v_ella -%}<button type="button" class="eprod__thumb" data-thumb="{{ v_ella.id }}" aria-label="{% if is_en %}For her{% else %}Para ella{% endif %}" data-on><img src="{{ v_ella.image | image_url: width: 160 }}" alt="" width="76" height="76"/></button>{%- endif -%}
        {%- if v_el -%}<button type="button" class="eprod__thumb" data-thumb="{{ v_el.id }}" aria-label="{% if is_en %}For him{% else %}Para él{% endif %}"><img src="{{ v_el.image | image_url: width: 160 }}" alt="" width="76" height="76"/></button>{%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <div class="eprod__info">
      <div class="eprod__eyebrow">{% if is_en %}THE PIECE{% else %}LA PIEZA{% endif %}{% if tfinish != blank %} · {{ tfinish | upcase }}{% endif %}</div>
      <h1 class="eprod__title">{{ tname }}</h1>
      <div class="eprod__desc">{% if is_en %}A sanctuary you wear. Living water from the Black Lagoon, suspended in blown glass.{% else %}Un santuario que se lleva puesto. Agua viva de la Laguna Negra, suspendida en cristal soplado.{% endif %}</div>

      {%- if product.variants.size > 1 -%}
      <div class="eprod__chainLabel">{% if is_en %}CHAIN · WHO IT IS FOR{% else %}CADENA · PARA QUIÉN ES{% endif %}</div>
      <div class="eprod__chains" role="radiogroup" aria-label="{% if is_en %}Chain{% else %}Cadena{% endif %}">
        {%- if v_ella -%}
        <button type="button" class="eprod__chainOpt" data-variant="{{ v_ella.id }}" role="radio" aria-checked="true" data-on>
          <span class="eprod__chainGlyph" aria-hidden>
            <svg width="46" height="14" viewBox="0 0 46 14" fill="none" focusable="false">
              <rect x="4"  y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
              <rect x="13" y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
              <rect x="22" y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
              <rect x="31" y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
            </svg>
          </span>
          <span class="eprod__chainText">
            <span class="eprod__chainName">{% if is_en %}For her{% else %}Para ella{% endif %}</span>
            <span class="eprod__chainSpec">{% if is_en %}50 cm · Panzer 050 · Sterling 925{% else %}50 cm · Panzer 050 · Ley 925{% endif %}</span>
          </span>
        </button>
        {%- endif -%}
        {%- if v_el -%}
        <button type="button" class="eprod__chainOpt" data-variant="{{ v_el.id }}" role="radio" aria-checked="false">
          <span class="eprod__chainGlyph" aria-hidden>
            <svg width="46" height="14" viewBox="0 0 46 14" fill="none" focusable="false">
              <rect x="2"  y="3" width="15" height="8" rx="4" stroke="currentColor" stroke-width="1.4"/>
              <rect x="15" y="3" width="15" height="8" rx="4" stroke="currentColor" stroke-width="1.4"/>
              <rect x="28" y="3" width="15" height="8" rx="4" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </span>
          <span class="eprod__chainText">
            <span class="eprod__chainName">{% if is_en %}For him{% else %}Para él{% endif %}</span>
            <span class="eprod__chainSpec">{% if is_en %}65 cm · Panzer 080 · Sterling 925{% else %}65 cm · Panzer 080 · Ley 925{% endif %}</span>
          </span>
        </button>
        {%- endif -%}
      </div>
      <div class="eprod__note">{% if is_en %}The chain does not change the price.{% else %}La cadena no altera el precio.{% endif %}</div>
      {%- endif -%}

      <div class="eprod__price"><span class="eprod-price">{{ v_default.price | money }}</span></div>
      <div class="eprod__meta">{% if is_en %}LIMITED EDITION · No. 01 / 100 · HANDMADE TO ORDER{% else %}EDICIÓN LIMITADA · N.º 01 / 100 · HECHA A MANO POR ENCARGO{% endif %}</div>

      {%- comment -%} Add-to-cart NATIVO: product-form custom element envuelve el form de producto.
        product-form.js intercepta el submit, añade vía Cart AJAX y abre el cart drawer re-skineado.
        El selector de cadena de abajo mantiene el input oculto [name=id] sincronizado. {%- endcomment -%}
      <product-form class="eprod-form" data-section-id="{{ section.id }}">
        {%- form 'product', product, id: 'eprod-form', class: 'eprod-buyform', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ v_default.id }}" class="eprod-vid">
          <button type="submit" name="add" class="eprod-buy"{% unless v_default.available %} disabled aria-disabled="true"{% endunless %}>
            <span>{% if v_default.available %}{% if is_en %}RESERVE YOUR PIECE{% else %}RESERVA TU PIEZA{% endif %}{% else %}{% if is_en %}SOLD OUT{% else %}AGOTADO{% endif %}{% endif %}</span>
            <span class="eprod-buy__arrow" aria-hidden="true">→</span>
            {%- render 'loading-spinner' -%}
          </button>
          <div class="eprod-buy__err product-form__error-message-wrapper" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>
        {%- endform -%}
      </product-form>
    </div>
  </div>

  <script type="application/json" id="eprod-variants">
    [{%- for v in product.variants -%}{%- unless forloop.first -%},{%- endunless -%}
      { "id": {{ v.id }}, "price": {{ v.price | money | json }}, "available": {{ v.available }}, "image": {{ v.image | image_url: width: 1200 | json }} }
    {%- endfor -%}]
  </script>
  <script>
    (function () {
      var box = document.querySelector('.eprod'); if (!box) return;
      var variants = JSON.parse(document.getElementById('eprod-variants').textContent);
      var img = box.querySelector('.eprod-img');
      var priceEl = box.querySelector('.eprod-price');
      var vidInput = box.querySelector('.eprod-vid');
      function select(id) {
        var v = variants.filter(function (x) { return String(x.id) === String(id); })[0];
        if (!v) return;
        if (vidInput) vidInput.value = v.id;   // sincroniza el <product-form> nativo
        if (priceEl) priceEl.textContent = v.price;
        if (img && v.image) img.src = v.image;
        box.querySelectorAll('[data-variant]').forEach(function (el) {
          var on = String(el.getAttribute('data-variant')) === String(id);
          if (on) { el.setAttribute('data-on', ''); el.setAttribute('aria-checked', 'true'); }
          else { el.removeAttribute('data-on'); el.setAttribute('aria-checked', 'false'); }
        });
        box.querySelectorAll('[data-thumb]').forEach(function (el) {
          if (String(el.getAttribute('data-thumb')) === String(id)) el.setAttribute('data-on', ''); else el.removeAttribute('data-on');
        });
      }
      box.querySelectorAll('[data-variant]').forEach(function (el) { el.addEventListener('click', function () { select(el.getAttribute('data-variant')); }); });
      box.querySelectorAll('[data-thumb]').forEach(function (el) { el.addEventListener('click', function () { select(el.getAttribute('data-thumb')); }); });
      // Añadir al carrito + apertura del drawer los maneja product-form.js (el
      // <product-form> que envuelve el botón). Aquí solo mantenemos el input
      // oculto [name=id] sincronizado con la cadena elegida.
    })();
  </script>
</section>

<section class="estory">
  <div class="estory-inner">{{ product.description }}</div>
</section>

