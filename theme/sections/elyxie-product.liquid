{%- comment -%}
  Página de producto ELYXIE — bespoke, en el vibe de la landing (emerald, Cormorant,
  champagne). Selector de cadena idéntico a la Vitrina (glifos SVG fine/curb, orden
  ella→él) + precio en vivo + buy-now (Cart AJAX). Borde redondeado (no la esquina
  viva de la Vitrina) por pedido.
{%- endcomment -%}
{%- assign tparts = product.title | split: '—' -%}
{%- assign tname = tparts[0] | strip -%}
{%- assign tfinish = tparts[1] | strip | default: '' -%}
{%- for v in product.variants -%}
  {%- if v.title contains 'ella' -%}{%- assign v_ella = v -%}{%- else -%}{%- assign v_el = v -%}{%- endif -%}
{%- endfor -%}
{%- assign v_default = v_ella | default: product.variants.first -%}

<style>
  .eprod { padding: clamp(8px,2vw,32px) clamp(20px,5vw,64px) clamp(56px,7vw,112px); }
  .eprod__wrap { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(28px,4vw,72px); align-items: start; max-width: 1240px; margin: 0 auto; }
  .eprod__media { position: relative; }
  .eprod__panel { position: relative; border-radius: 18px; overflow: hidden;
    box-shadow: 0 20px 60px rgba(5,22,19,0.55), inset 0 0 0 1px rgba(255,255,255,0.06); background: #0E2E26; }
  .eprod__panel img { display: block; width: 100%; height: auto; aspect-ratio: 1/1; object-fit: cover; }
  .eprod__chip { position: absolute; top: 16px; left: 16px; z-index: 2; padding: 8px 14px;
    background: rgba(5,22,19,0.55); backdrop-filter: blur(6px); border: 1px solid rgba(233,215,177,0.28);
    color: var(--ep-champ); font-size: 10px; letter-spacing: 0.26em; }
  .eprod__thumbs { display: flex; gap: 12px; margin-top: 16px; }
  .eprod__thumb { width: 76px; height: 76px; border-radius: 10px; overflow: hidden; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1); opacity: 0.55; transition: opacity 220ms ease, border-color 220ms ease; background:#0E2E26; padding:0; }
  .eprod__thumb[data-on] { opacity: 1; border-color: var(--ep-champ); }
  .eprod__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .eprod__eyebrow { font-size: 11px; letter-spacing: 0.32em; color: var(--ep-champ); text-transform: uppercase; }
  .eprod__title { font-family: var(--ep-serif); font-weight: 400; font-size: clamp(40px,5vw,68px);
    line-height: 1.02; letter-spacing: -0.01em; margin: 18px 0 0; }
  .eprod__title em { font-style: italic; color: var(--ep-champ); }
  .eprod__desc { margin: 22px 0 0; max-width: 46ch; color: rgba(255,255,255,0.74); font-size: 16px; line-height: 1.7; }
  .eprod__desc p { margin: 0; }

  /* ── Chain selector — replica exacta de la Vitrina (glifo + nombre + spec) ── */
  .eprod__chainLabel { display: block; margin: 34px 0 13px; font-family: var(--ep-sans);
    font-size: 10px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(255,255,255,0.56); }
  .eprod__chains { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
  .eprod__chainOpt { display: flex; align-items: center; gap: 13px; padding: 15px 16px; text-align: left; cursor: pointer;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; /* redondeado (por pedido) */
    transition: border-color 280ms cubic-bezier(0.2,0,0,1), background 280ms cubic-bezier(0.2,0,0,1), box-shadow 280ms cubic-bezier(0.2,0,0,1);
    color: #fff; font-family: var(--ep-sans); }
  .eprod__chainOpt:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); }
  .eprod__chainOpt[data-on] { border-color: var(--ep-champ);
    background: color-mix(in srgb, var(--ep-champ) 8%, transparent); box-shadow: 0 0 22px rgba(233,215,177,0.10); }
  .eprod__chainGlyph { flex: none; display: flex; color: rgba(255,255,255,0.5); transition: color 280ms cubic-bezier(0.2,0,0,1); }
  .eprod__chainOpt[data-on] .eprod__chainGlyph { color: var(--ep-champ); }
  .eprod__chainText { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .eprod__chainName { font-family: var(--ep-sans); font-size: 14px; font-weight: 500; letter-spacing: 0.01em;
    color: rgba(255,255,255,0.72); transition: color 280ms cubic-bezier(0.2,0,0,1); }
  .eprod__chainOpt[data-on] .eprod__chainName { color: #fff; }
  .eprod__chainSpec { font-family: var(--ep-sans); font-size: 11px; letter-spacing: 0.02em;
    color: rgba(255,255,255,0.55); font-variant-numeric: tabular-nums; }

  .eprod__note { margin-top: 12px; font-size: 12px; color: rgba(255,255,255,0.45); }
  .eprod__price { margin: 30px 0 4px; font-family: var(--ep-serif); font-size: clamp(34px,4vw,52px); color: #fff; }
  .eprod__meta { font-size: 11px; letter-spacing: 0.22em; color: rgba(255,255,255,0.5); }
  .eprod-buy { margin-top: 26px; display: inline-flex; align-items: center; gap: 14px;
    padding: 18px 34px; border: 0; cursor: pointer; border-radius: 0;
    background: linear-gradient(180deg, #E9D7B1, #C9A66B); color: #0A2620;
    font-family: var(--ep-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase;
    box-shadow: 0 0 30px rgba(233,215,177,0.25); transition: box-shadow 240ms ease, opacity 220ms ease; }
  .eprod-buy:hover { box-shadow: 0 0 60px rgba(233,215,177,0.35), 0 0 120px rgba(233,215,177,0.18); }
  .eprod-buy[data-busy] { pointer-events: none; opacity: 0.7; }
  .eprod-buy span { transition: transform 220ms cubic-bezier(0.2,0,0,1); }
  .eprod-buy:hover span { transform: translateX(5px); }
  @media (max-width: 860px){ .eprod__wrap { grid-template-columns: 1fr; } .eprod__chains { grid-template-columns: 1fr; } }
</style>

<section class="eprod">
  <div class="eprod__wrap">
    <div class="eprod__media">
      <div class="eprod__panel">
        <span class="eprod__chip">EDICIÓN LIMITADA · N.º 01 / 100</span>
        <img class="eprod-img" src="{{ v_default.image | default: product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="600" height="600"/>
      </div>
      {%- if product.variants.size > 1 -%}
      <div class="eprod__thumbs">
        {%- if v_ella -%}<button type="button" class="eprod__thumb" data-thumb="{{ v_ella.id }}" aria-label="Para ella" data-on><img src="{{ v_ella.image | image_url: width: 160 }}" alt="" width="76" height="76"/></button>{%- endif -%}
        {%- if v_el -%}<button type="button" class="eprod__thumb" data-thumb="{{ v_el.id }}" aria-label="Para él"><img src="{{ v_el.image | image_url: width: 160 }}" alt="" width="76" height="76"/></button>{%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <div class="eprod__info">
      <div class="eprod__eyebrow">LA PIEZA{% if tfinish != blank %} · {{ tfinish | upcase }}{% endif %}</div>
      <h1 class="eprod__title">{{ tname }}{% if tfinish != blank %} <em>{{ tfinish }}</em>{% endif %}</h1>
      <div class="eprod__desc">{{ product.description }}</div>

      {%- if product.variants.size > 1 -%}
      <div class="eprod__chainLabel">CADENA · PARA QUIÉN ES</div>
      <div class="eprod__chains" role="radiogroup" aria-label="Cadena">
        {%- if v_ella -%}
        <button type="button" class="eprod__chainOpt" data-variant="{{ v_ella.id }}" role="radio" aria-checked="true" data-on>
          <span class="eprod__chainGlyph" aria-hidden>
            <svg width="46" height="14" viewBox="0 0 46 14" fill="none" focusable="false">
              <rect x="4"  y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
              <rect x="13" y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
              <rect x="22" y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
              <rect x="31" y="4" width="12" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/>
            </svg>
          </span>
          <span class="eprod__chainText">
            <span class="eprod__chainName">Para ella</span>
            <span class="eprod__chainSpec">50 cm · Panzer 050 · Ley 925</span>
          </span>
        </button>
        {%- endif -%}
        {%- if v_el -%}
        <button type="button" class="eprod__chainOpt" data-variant="{{ v_el.id }}" role="radio" aria-checked="false">
          <span class="eprod__chainGlyph" aria-hidden>
            <svg width="46" height="14" viewBox="0 0 46 14" fill="none" focusable="false">
              <rect x="2"  y="3" width="15" height="8" rx="4" stroke="currentColor" stroke-width="1.4"/>
              <rect x="15" y="3" width="15" height="8" rx="4" stroke="currentColor" stroke-width="1.4"/>
              <rect x="28" y="3" width="15" height="8" rx="4" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </span>
          <span class="eprod__chainText">
            <span class="eprod__chainName">Para él</span>
            <span class="eprod__chainSpec">65 cm · Panzer 080 · Ley 925</span>
          </span>
        </button>
        {%- endif -%}
      </div>
      <div class="eprod__note">La cadena no altera el precio.</div>
      {%- endif -%}

      <div class="eprod__price"><span class="eprod-price">{{ v_default.price | money }}</span></div>
      <div class="eprod__meta">EDICIÓN LIMITADA · N.º 01 / 100 · HECHA A MANO POR ENCARGO</div>

      <button type="button" class="eprod-buy">RESERVA TU PIEZA <span>→</span></button>
    </div>
  </div>

  <script type="application/json" id="eprod-variants">
    [{%- for v in product.variants -%}{%- unless forloop.first -%},{%- endunless -%}
      { "id": {{ v.id }}, "price": {{ v.price | money | json }}, "available": {{ v.available }}, "image": {{ v.image | image_url: width: 1200 | json }} }
    {%- endfor -%}]
  </script>
  <script>
    (function () {
      var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      var box = document.querySelector('.eprod'); if (!box) return;
      var variants = JSON.parse(document.getElementById('eprod-variants').textContent);
      var defaultId = {{ v_default.id | json }};
      var current = variants.filter(function (v) { return String(v.id) === String(defaultId); })[0] || variants[0];
      var img = box.querySelector('.eprod-img');
      var priceEl = box.querySelector('.eprod-price');
      function select(id) {
        var v = variants.filter(function (x) { return String(x.id) === String(id); })[0];
        if (!v) return; current = v;
        if (priceEl) priceEl.textContent = v.price;
        if (img && v.image) img.src = v.image;
        box.querySelectorAll('[data-variant]').forEach(function (el) {
          var on = String(el.getAttribute('data-variant')) === String(id);
          if (on) { el.setAttribute('data-on', ''); el.setAttribute('aria-checked', 'true'); }
          else { el.removeAttribute('data-on'); el.setAttribute('aria-checked', 'false'); }
        });
        box.querySelectorAll('[data-thumb]').forEach(function (el) {
          if (String(el.getAttribute('data-thumb')) === String(id)) el.setAttribute('data-on', ''); else el.removeAttribute('data-on');
        });
      }
      box.querySelectorAll('[data-variant]').forEach(function (el) { el.addEventListener('click', function () { select(el.getAttribute('data-variant')); }); });
      box.querySelectorAll('[data-thumb]').forEach(function (el) { el.addEventListener('click', function () { select(el.getAttribute('data-thumb')); }); });
      var btn = box.querySelector('.eprod-buy');
      btn.addEventListener('click', function () {
        if (!current) return;
        btn.setAttribute('data-busy', '');
        fetch(root + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: current.id, quantity: 1 }] }) })
          .then(function (r) { if (!r.ok) throw new Error('add'); window.location.href = root + 'checkout'; })
          .catch(function () { btn.removeAttribute('data-busy'); window.location.href = root + 'cart'; });
      });
    })();
  </script>
</section>

{% schema %}
{ "name": "Producto ELYXIE", "settings": [] }
{% endschema %}
