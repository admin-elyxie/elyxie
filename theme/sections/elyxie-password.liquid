{%- comment -%}
  Password ELYXIE — splash de tienda bloqueada. Vive bajo el layout `elyxie-password`
  (mínimo, sin nav/cart/footer). Wordmark champán + mensaje de marca bilingüe + el
  form inline `{% form 'storefront_password' %}` (sin el modal de Dawn → no depende de
  password-modal.js). Campos/botón verbatim de Dawn: name="password", name="commit",
  rama form.errors. Bilingüe ES/EN.
{%- endcomment -%}
{%- assign is_en = false -%}
{%- if request.locale.iso_code == 'en' -%}{%- assign is_en = true -%}{%- endif -%}

{%- assign eyebrow = section.settings.eyebrow | strip -%}
{%- if eyebrow == blank -%}{%- assign eyebrow = 'Sacred Waters' -%}{%- endif -%}
{%- assign heading = section.settings.heading | strip -%}
{%- if heading == blank -%}{%- if is_en -%}{%- assign heading = 'Opening soon' -%}{%- else -%}{%- assign heading = 'Próximamente' -%}{%- endif -%}{%- endif -%}

<style>
  .epwd-splash { width: 100%; max-width: 540px; margin: 0 auto; text-align: center; }
  .epwd-halo { position: relative; }
  .epwd-halo::before { content: ""; position: absolute; left: 50%; top: 46%; transform: translate(-50%,-50%);
    width: 320px; height: 320px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(233,215,177,0.10) 0%, rgba(233,215,177,0) 68%);
    animation: epwd-breathe 6s ease-in-out infinite; }
  @keyframes epwd-breathe { 0%,100% { opacity: 0.7; } 50% { opacity: 1; } }

  .epwd-mark { display: inline-block; position: relative; width: clamp(160px,32vw,224px); height: 52px;
    background-color: var(--ep-champ);
    -webkit-mask: url("{{ 'elyxie-wordmark.svg' | asset_url }}") no-repeat center / contain;
            mask: url("{{ 'elyxie-wordmark.svg' | asset_url }}") no-repeat center / contain; }
  .epwd-eyebrow { margin: clamp(30px,4.4vw,44px) 0 0; font-family: var(--ep-sans); font-size: 11px; font-weight: 500;
    letter-spacing: 0.36em; text-transform: uppercase; color: var(--ep-champ); }
  .epwd-title { margin: clamp(14px,1.8vw,22px) 0 0; font-family: var(--ep-serif); font-style: italic; font-weight: 400;
    font-size: clamp(36px,6vw,62px); line-height: 1.04; letter-spacing: -0.02em; color: var(--ep-ink); text-wrap: balance; }
  .epwd-msg { margin: clamp(16px,2vw,22px) auto 0; max-width: 46ch; font-family: var(--ep-sans); font-size: 15px;
    line-height: 1.7; color: rgba(255,255,255,0.74); }
  .epwd-msg p { margin: 0 0 10px; } .epwd-msg :last-child { margin-bottom: 0; }

  .epwd-form { margin: clamp(36px,5vw,54px) auto 0; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; max-width: 460px; }
  .epwd-field { flex: 1 1 220px; min-width: 0; }
  .epwd-field .field__input { width: 100%; display: block; margin: 0; appearance: none; -webkit-appearance: none;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.18); border-radius: 0; color: var(--ep-ink);
    font-family: var(--ep-sans); font-size: 15px; line-height: 1.4; padding: 15px 18px; min-height: 54px; text-align: center;
    transition: border-color 240ms ease, background 240ms ease; }
  .epwd-field .field__input::placeholder { color: rgba(255,255,255,0.45); letter-spacing: 0.04em; }
  .epwd-field .field__input:focus { outline: none; border-color: var(--ep-champ); background: rgba(255,255,255,0.06); }
  .epwd-field--error .field__input { border-color: #D97757; }
  .epwd-error { display: block; flex: 1 0 100%; margin: 2px 0 0; font-family: var(--ep-sans); font-size: 12px;
    letter-spacing: 0.02em; color: #D97757; }
  .epwd-error .svg-wrapper, .epwd-error .visually-hidden { display: none; }

  .epwd-submit { flex: none; display: inline-flex; align-items: center; justify-content: center; appearance: none;
    -webkit-appearance: none; cursor: pointer; border: 0; border-radius: 0; padding: 15px 34px; min-height: 54px;
    background: linear-gradient(180deg, #E9D7B1, #C9A66B); color: #0A2620; font-family: var(--ep-sans); font-size: 11px;
    font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; box-shadow: 0 0 30px rgba(233,215,177,0.22);
    transition: box-shadow 360ms ease; }
  .epwd-submit:hover { box-shadow: 0 0 46px rgba(233,215,177,0.4); }
  .epwd-submit:focus-visible { outline: 2px solid var(--ep-champ); outline-offset: 4px; }

  .epwd-admin { margin: clamp(28px,4vw,42px) 0 0; font-family: var(--ep-sans); font-size: 11px; letter-spacing: 0.04em;
    color: rgba(255,255,255,0.4); }
  .epwd-admin a { color: rgba(233,215,177,0.8); text-decoration: none; border-bottom: 1px solid rgba(233,215,177,0.22); }
  .epwd-admin a:hover { color: var(--ep-champ); }

  @media (prefers-reduced-motion: reduce) { .epwd-halo::before { animation: none; } }
</style>

<div class="epwd-splash epwd-halo">
  <a href="{{ routes.root_url }}" class="epwd-mark" aria-label="{{ shop.name | escape }}"></a>
  <p class="epwd-eyebrow">{{ eyebrow }}</p>
  <h1 class="epwd-title">{{ heading }}</h1>

  {%- if section.settings.message != blank -%}
    <div class="epwd-msg">{{ section.settings.message }}</div>
  {%- elsif shop.password_message != blank -%}
    <div class="epwd-msg">{{ shop.password_message }}</div>
  {%- else -%}
    <p class="epwd-msg">
      {%- if is_en -%}Sacred water from the Black Lagoon of Peru, gathered for those who understand that some things are guarded.
      {%- else -%}Agua sagrada de la Laguna Negra del Perú, reunida para quien entiende que hay cosas que se protegen.{%- endif -%}
    </p>
  {%- endif -%}

  {%- if section.settings.show_password_form -%}
    {%- form 'storefront_password', class: 'epwd-form' -%}
      <div class="epwd-field{% if form.errors %} epwd-field--error{% endif %}">
        <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input
          type="password"
          name="password"
          id="Password"
          class="field__input"
          autocomplete="current-password"
          {% if form.errors %}aria-invalid="true" aria-describedby="PasswordLoginForm-password-error"{% endif %}
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
        >
        {%- if form.errors -%}
          <small id="PasswordLoginForm-password-error" class="epwd-error" role="status">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            {{ 'general.password_page.login_form_error' | t }}
          </small>
        {%- endif -%}
      </div>
      <button name="commit" class="epwd-submit">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}
  {%- endif -%}

  <p class="epwd-admin">{{ 'general.password_page.admin_link_html' | t }}</p>
</div>

{% schema %}
{
  "name": "Password ELYXIE",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Vacío = 'Sacred Waters'" },
    { "type": "text", "id": "heading", "label": "Título", "info": "Vacío = 'Próximamente' / 'Opening soon'" },
    { "type": "richtext", "id": "message", "label": "Mensaje", "info": "Vacío = mensaje de la tienda (Preferencias) o frase de marca" },
    { "type": "checkbox", "id": "show_password_form", "label": "Mostrar entrada de contraseña (staff)", "default": true }
  ],
  "presets": [{ "name": "Password ELYXIE" }]
}
{% endschema %}
