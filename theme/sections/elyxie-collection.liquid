{%- comment -%}
  Colección ELYXIE — galería editorial de piezas, NO un grid de e-commerce.
  Vive bajo el layout `elyxie-page` (wordmark champán + ES/EN + carrito + footer
  de marca + vacío esmeralda). El sistema de diseño prohíbe explícitamente el
  "Añadir al carrito como protagonista" en grids: cada pieza enlaza a su PDP
  editorial (donde vive el selector de cadena + el cart drawer). Bilingüe ES/EN.
{%- endcomment -%}
{%- assign is_en = false -%}
{%- if request.locale.iso_code == 'en' -%}{%- assign is_en = true -%}{%- endif -%}

{%- comment -%} Título: override del editor → título de colección → frase de marca (si es el catch-all). {%- endcomment -%}
{%- assign heading = section.settings.heading | strip -%}
{%- if heading == blank -%}
  {%- if collection.handle == 'all' or collection.title == 'Products' or collection.title == 'Productos' -%}
    {%- if is_en -%}{%- assign heading = 'The Pieces' -%}{%- else -%}{%- assign heading = 'Las Piezas' -%}{%- endif -%}
  {%- else -%}
    {%- assign heading = collection.title -%}
  {%- endif -%}
{%- endif -%}
{%- assign eyebrow = section.settings.eyebrow | strip -%}
{%- if eyebrow == blank -%}{%- if is_en -%}{%- assign eyebrow = 'The Collection' -%}{%- else -%}{%- assign eyebrow = 'La Colección' -%}{%- endif -%}{%- endif -%}

<style>
  .ecol {
    --ec-surface: #0E2E26;
    --ec-hair: rgba(255,255,255,0.08);
    --ec-hair-champ: rgba(233,215,177,0.22);
    max-width: 1240px; margin: 0 auto;
    padding: clamp(40px,7vw,104px) clamp(20px,5vw,64px) clamp(88px,13vw,168px);
  }

  /* ── Cabecera editorial ────────────────────────────────────────────────── */
  .ecol__head { margin-bottom: clamp(40px,6vw,72px); }
  .ecol__eyebrow { margin: 0; font-family: var(--ep-sans); font-size: 11px; font-weight: 500;
    letter-spacing: 0.32em; text-transform: uppercase; color: var(--ep-champ); }
  .ecol__title { margin: clamp(14px,1.6vw,20px) 0 0; font-family: var(--ep-serif); font-style: italic;
    font-weight: 400; font-size: clamp(42px,6.4vw,88px); line-height: 1.0; letter-spacing: -0.02em;
    color: var(--ep-ink); text-wrap: balance; }
  .ecol__desc { margin: clamp(18px,2vw,26px) 0 0; max-width: 56ch; font-family: var(--ep-sans);
    font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.74); }
  .ecol__desc p { margin: 0; }

  .ecol__meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px;
    flex-wrap: wrap; margin-top: clamp(28px,4vw,44px); }
  .ecol__count { font-family: var(--ep-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.22em;
    text-transform: uppercase; color: rgba(255,255,255,0.62); font-variant-numeric: tabular-nums; }

  /* sort — esquina viva, hairline champán (los inputs de la marca son nítidos) */
  .ecol__sort { display: inline-flex; align-items: center; gap: 12px; margin: 0; }
  .ecol__sort-label { font-family: var(--ep-sans); font-size: 10px; font-weight: 500; letter-spacing: 0.28em;
    text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .ecol__select { position: relative; display: inline-flex; align-items: center; }
  .ecol__select select { appearance: none; -webkit-appearance: none; cursor: pointer;
    margin: 0; padding: 6px 26px 7px 2px; background: transparent; border: 0;
    border-bottom: 1px solid var(--ec-hair-champ); border-radius: 0;
    font-family: var(--ep-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em;
    color: var(--ep-champ); transition: border-color 240ms ease, color 240ms ease; }
  .ecol__select select:hover { color: #fff; border-color: rgba(233,215,177,0.5); }
  .ecol__select select:focus-visible { outline: 2px solid var(--ep-champ); outline-offset: 4px; }
  .ecol__select option { color: #0A2620; }
  .ecol__select svg { position: absolute; right: 4px; pointer-events: none; color: var(--ep-champ); }

  .ecol__rule { height: 1px; border: 0; margin: clamp(26px,3vw,38px) 0 0;
    background: linear-gradient(90deg, var(--ec-hair-champ), rgba(255,255,255,0.05) 40%, transparent); }

  /* ── Grid de piezas ────────────────────────────────────────────────────── */
  .ecol__grid { list-style: none; margin: clamp(40px,6vw,72px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
    gap: clamp(40px,5vw,72px) clamp(24px,3vw,44px); }

  .ecard { --i: 0; opacity: 0; transform: translateY(18px);
    animation: ecard-rise 760ms cubic-bezier(0.05,0.7,0.1,1) both;
    animation-delay: calc(var(--i) * 90ms); }
  @keyframes ecard-rise { to { opacity: 1; transform: none; } }

  .ecard__link { display: block; text-decoration: none; color: inherit; }
  .ecard__link:focus-visible { outline: none; }
  .ecard__link:focus-visible .ecard__frame { outline: 2px solid var(--ep-champ); outline-offset: 4px; }

  /* marco luminoso — el shot de estudio (fondo claro) flota sobre el vacío */
  .ecard__frame { position: relative; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden;
    background: var(--ec-surface);
    box-shadow: 0 20px 60px rgba(5,22,19,0.45), inset 0 0 0 1px rgba(255,255,255,0.06);
    transition: box-shadow 420ms cubic-bezier(0.2,0,0,1); }
  .ecard__img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 38%;
    transition: transform 760ms cubic-bezier(0.2,0,0,1); }
  .ecard__frame--empty { display: grid; place-items: center; color: rgba(255,255,255,0.3);
    font-family: var(--ep-serif); font-style: italic; font-size: 20px; }

  .ecard__link:hover .ecard__img { transform: scale(1.045); }
  .ecard__link:hover .ecard__frame {
    box-shadow: 0 24px 70px rgba(5,22,19,0.55), 0 0 54px rgba(233,215,177,0.12),
                inset 0 0 0 1px rgba(233,215,177,0.24); }

  .ecard__body { padding-top: 20px; }
  .ecard__finish { margin: 0 0 9px; font-family: var(--ep-sans); font-size: 10px; font-weight: 500;
    letter-spacing: 0.3em; text-transform: uppercase; color: var(--ep-champ); }
  .ecard__name { margin: 0; font-family: var(--ep-serif); font-weight: 400; font-size: clamp(23px,2.2vw,29px);
    line-height: 1.08; letter-spacing: -0.01em; color: var(--ep-ink); }

  .ecard__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    margin-top: 16px; padding-top: 15px; border-top: 1px solid var(--ec-hair); }
  .ecard__price { font-family: var(--ep-serif); font-size: 21px; color: #fff; font-variant-numeric: tabular-nums; }
  .ecard__cta { display: inline-flex; align-items: center; gap: 8px; flex: none;
    font-family: var(--ep-sans); font-size: 10.5px; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(233,215,177,0.85); transition: color 240ms ease; }
  .ecard__cta svg { transition: transform 240ms cubic-bezier(0.2,0,0,1); }
  .ecard__link:hover .ecard__cta { color: var(--ep-champ); }
  .ecard__link:hover .ecard__cta svg { transform: translateX(4px); }

  /* ── Vacío + paginación ────────────────────────────────────────────────── */
  .ecol__empty { padding: clamp(56px,10vw,120px) 0; text-align: center; }
  .ecol__empty p { margin: 0; font-family: var(--ep-serif); font-style: italic; font-size: clamp(22px,3vw,30px);
    color: rgba(255,255,255,0.7); }
  .ecol__empty a { display: inline-block; margin-top: 22px; font-family: var(--ep-sans); font-size: 11px;
    font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ep-champ);
    text-decoration: none; border-bottom: 1px solid var(--ec-hair-champ); padding-bottom: 4px; }

  .ecol__pager { display: flex; justify-content: center; gap: 10px; margin-top: clamp(48px,7vw,88px); }
  .ecol__pager a, .ecol__pager span { min-width: 40px; height: 40px; display: inline-flex; align-items: center;
    justify-content: center; font-family: var(--ep-sans); font-size: 12px; letter-spacing: 0.04em;
    color: rgba(255,255,255,0.55); text-decoration: none; border: 1px solid var(--ec-hair);
    transition: color 220ms ease, border-color 220ms ease; }
  .ecol__pager a:hover { color: #fff; border-color: var(--ec-hair-champ); }
  .ecol__pager span[aria-current] { color: #0A2620; background: var(--ep-champ); border-color: var(--ep-champ); }

  @media (max-width: 600px) {
    /* una sola pieza luminosa por fila — "sentir la pieza" */
    .ecol__grid { grid-template-columns: 1fr; gap: 44px; }
    .ecard__frame { aspect-ratio: 4 / 5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ecard { opacity: 1; transform: none; animation: none; }
    .ecard__img, .ecard__cta svg, .ecard__frame { transition: none; }
    .ecard__link:hover .ecard__img { transform: none; }
  }
</style>

<section class="ecol">
  <header class="ecol__head">
    <p class="ecol__eyebrow">{{ eyebrow }}</p>
    <h1 class="ecol__title">{{ heading }}</h1>

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="ecol__desc">{{ collection.description }}</div>
    {%- endif -%}

    {%- if collection.products_count > 0 -%}
      <div class="ecol__meta">
        <span class="ecol__count">
          {{ collection.products_count }}
          {%- if collection.products_count == 1 -%}{% if is_en %} piece{% else %} pieza{% endif %}
          {%- else -%}{% if is_en %} pieces{% else %} piezas{% endif %}{%- endif -%}
        </span>

        {%- if section.settings.show_sort and collection.sort_options.size > 1 -%}
          <form method="get" class="ecol__sort">
            <label class="ecol__sort-label" for="ecol-sort">{% if is_en %}Sort{% else %}Orden{% endif %}</label>
            <span class="ecol__select">
              <select id="ecol-sort" name="sort_by" onchange="this.form.submit()">
                {%- for opt in collection.sort_options -%}
                  <option value="{{ opt.value }}"{% if opt.value == collection.sort_by %} selected{% endif %}>{{ opt.name }}</option>
                {%- endfor -%}
              </select>
              <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
                <path d="M1 1l4.5 4L10 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
            </span>
            <noscript><button type="submit" class="ecol__sort-label" style="background:none;border:0;color:var(--ep-champ);cursor:pointer">{% if is_en %}Apply{% else %}Aplicar{% endif %}</button></noscript>
          </form>
        {%- endif -%}
      </div>
    {%- endif -%}

    <hr class="ecol__rule">
  </header>

  {%- if collection.products_count > 0 -%}
    {%- paginate collection.products by section.settings.products_per_page -%}
      <ul class="ecol__grid" role="list">
        {%- for product in collection.products -%}
          {%- assign tparts = product.title | split: '·' -%}
          {%- assign tname = tparts[0] | strip -%}
          {%- assign tfinish = tparts[1] | strip -%}
          <li class="ecard" style="--i: {{ forloop.index0 }}">
            <a class="ecard__link" href="{{ product.url }}">
              <div class="ecard__frame{% unless product.featured_media %} ecard__frame--empty{% endunless %}">
                {%- if product.featured_media -%}
                  <img class="ecard__img"
                    src="{{ product.featured_media | image_url: width: 700 }}"
                    srcset="{{ product.featured_media | image_url: width: 400 }} 400w,
                            {{ product.featured_media | image_url: width: 600 }} 600w,
                            {{ product.featured_media | image_url: width: 800 }} 800w,
                            {{ product.featured_media | image_url: width: 1100 }} 1100w"
                    sizes="(max-width: 600px) 90vw, (max-width: 1000px) 44vw, 380px"
                    alt="{{ product.title | escape }}"
                    width="700" height="875"
                    loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}">
                {%- else -%}
                  {{ tname | default: product.title }}
                {%- endif -%}
              </div>
              <div class="ecard__body">
                {%- if tfinish != blank -%}<p class="ecard__finish">{{ tfinish | upcase }}</p>{%- endif -%}
                <h2 class="ecard__name">{{ tname | default: product.title }}</h2>
                <div class="ecard__foot">
                  <span class="ecard__price">
                    {%- if product.price_varies -%}{% if is_en %}From {% else %}Desde {% endif %}{%- endif -%}
                    {{- product.price | money -}}
                  </span>
                  <span class="ecard__cta">
                    {% if is_en %}View the piece{% else %}Ver la pieza{% endif %}
                    <svg width="13" height="9" viewBox="0 0 13 9" fill="none" aria-hidden="true">
                      <path d="M1 4.5h10M7.5 1L11 4.5 7.5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="ecol__pager" role="navigation" aria-label="{% if is_en %}Pagination{% else %}Paginación{% endif %}">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{% if is_en %}Previous{% else %}Anterior{% endif %}">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{% if is_en %}Next{% else %}Siguiente{% endif %}">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="ecol__empty">
      <p>{% if is_en %}No pieces in this collection yet.{% else %}Aún no hay piezas en esta colección.{% endif %}</p>
      <a href="{{ routes.all_products_collection_url }}">{% if is_en %}See all pieces{% else %}Ver todas las piezas{% endif %}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Colección ELYXIE",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Vacío = 'La Colección' / 'The Collection'" },
    { "type": "text", "id": "heading", "label": "Título", "info": "Vacío = título de la colección" },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descripción de la colección", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Mostrar orden", "default": true },
    { "type": "range", "id": "products_per_page", "min": 6, "max": 24, "step": 2, "label": "Piezas por página", "default": 12 }
  ],
  "presets": [{ "name": "Colección ELYXIE" }]
}
{% endschema %}
