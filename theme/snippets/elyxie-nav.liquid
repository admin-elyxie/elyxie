{%- comment -%}
  elyxie-nav — EL header del sitio (fuente única de verdad).
  Lo consumen ambos layouts: elyxie.liquid (home, vía la sección
  elyxie-header del header group) y elyxie-page.liquid (resto de plantillas).
  El estilo vive en styles.css (.nav, .nav__lang, .mobile-drawer…): el mismo
  CSS que vestía el nav React de la home — por eso es visualmente idéntico.
  Sustituye al antiguo <Nav> de app.jsx y al .epage-nav de elyxie-page.

  Piezas:
  · Wordmark serif crema (máscara elyxie-wordmark.svg vía .elyxie-logo)
  · Links del Admin (linklists elyxie-header-es/en según locale)
  · Toggle ES/EN = form de localization de Shopify (navega conservando la
    ruta; Shopify emite return_to). Guarda la elección en localStorage para
    que el default por geolocalización no la pise.
  · Cuenta (routes.account_url) + Bolsa (#cart-icon-bubble → cart-drawer.js)
  · Burger + drawer móvil en vanilla JS (mismas clases/aria que el React)
{%- endcomment -%}

{%- if request.locale.iso_code == 'en' -%}
  {%- assign navlinks = linklists['elyxie-header-en'] -%}
  {%- assign t_account = 'Account' -%}
  {%- assign t_cart = 'Cart' -%}
  {%- assign t_lang = 'Language' -%}
  {%- assign t_open = 'Open menu' -%}
  {%- assign t_close = 'Close menu' -%}
  {%- assign t_contact = 'CONTACT US' -%}
  {%- assign t_copy = '© 2026 ELYXIE · Custodians of Mamayacu' -%}
  {%- assign contact_url = '/en/pages/contact' -%}
{%- else -%}
  {%- assign navlinks = linklists['elyxie-header-es'] -%}
  {%- assign t_account = 'Cuenta' -%}
  {%- assign t_cart = 'Carrito' -%}
  {%- assign t_lang = 'Idioma' -%}
  {%- assign t_open = 'Abrir menú' -%}
  {%- assign t_close = 'Cerrar menú' -%}
  {%- assign t_contact = 'CONTÁCTANOS' -%}
  {%- assign t_copy = '© 2026 ELYXIE · Custodios de Mamayacu' -%}
  {%- assign contact_url = '/pages/contact' -%}
{%- endif -%}
{%- assign cur_iso = localization.language.iso_code | downcase -%}
{%- assign lang_es = nil -%}{%- assign lang_en = nil -%}
{%- for language in localization.available_languages -%}
  {%- assign _iso = language.iso_code | downcase -%}
  {%- if _iso == 'es' -%}{%- assign lang_es = language -%}{%- elsif _iso == 'en' -%}{%- assign lang_en = language -%}{%- endif -%}
{%- endfor -%}
{%- if cur_iso == 'en' -%}{%- assign lang_pos = 1 -%}{%- else -%}{%- assign lang_pos = 0 -%}{%- endif -%}

<nav class="nav" id="elyxie-nav" data-drawer-open="false">
  <a class="nav__brand" href="{{ routes.root_url }}" aria-label="Elyxie"><span class="elyxie-logo" aria-hidden="true"></span></a>

  <div class="nav__links">
    {%- for l in navlinks.links -%}
      <a class="nav__link" href="{{ l.url }}">{{ l.title }}</a>
    {%- endfor -%}
  </div>

  {%- comment -%} --lang-pos vive en el wrapper (las custom properties heredan):
    el ::before deslizante de .nav__lang la lee desde el form. {%- endcomment -%}
  <div class="nav__right" style="--lang-pos: {{ lang_pos }};">
    {%- form 'localization', class: 'nav__lang' -%}
      {%- if lang_es -%}<button type="submit" name="locale_code" value="{{ lang_es.iso_code }}" data-active="{% if cur_iso == 'es' %}true{% else %}false{% endif %}" aria-pressed="{% if cur_iso == 'es' %}true{% else %}false{% endif %}" aria-label="Español" onclick="try{localStorage.setItem('elyxie_lang_choice','es')}catch(e){}">ES</button>{%- endif -%}
      {%- if lang_en -%}<button type="submit" name="locale_code" value="{{ lang_en.iso_code }}" data-active="{% if cur_iso == 'en' %}true{% else %}false{% endif %}" aria-pressed="{% if cur_iso == 'en' %}true{% else %}false{% endif %}" aria-label="English" onclick="try{localStorage.setItem('elyxie_lang_choice','en')}catch(e){}">EN</button>{%- endif -%}
    {%- endform -%}

    <div class="nav__actions">
      <a class="nav__action nav__action--account" href="{{ routes.account_url }}" aria-label="{{ t_account }}">
        <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
      </a>
      {%- comment -%} #cart-icon-bubble: cart-drawer.js lo engancha para abrir el
        drawer; la Section Rendering API (sección cart-icon-bubble) reemplaza su
        innerHTML al actualizar el carrito — el id debe existir UNA sola vez. {%- endcomment -%}
      <a href="{{ routes.cart_url }}" id="cart-icon-bubble" class="nav__action nav__action--cart" aria-label="{{ t_cart }}">
        {%- if cart == empty -%}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {%- else -%}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {%- endif -%}
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}<span aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>

    <div class="nav__mobile-actions">
      <button class="nav__icon-btn nav__icon-btn--menu" type="button"
              aria-label="{{ t_open }}" aria-expanded="false"
              data-label-open="{{ t_open }}" data-label-close="{{ t_close }}">
        <svg class="nav__icon-burger" width="18" height="14" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 3h18M3 9h18M3 15h18"/></svg>
        <svg class="nav__icon-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-drawer" id="elyxie-drawer" data-open="false" aria-hidden="true">
  <div class="mobile-drawer__inner">
    <ul class="mobile-drawer__list">
      {%- for l in navlinks.links -%}
        <li class="mobile-drawer__item">
          <a class="mobile-drawer__row" href="{{ l.url }}">
            <span>{{ l.title }}</span>
            <span class="mobile-drawer__chev" aria-hidden="true">→</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%} Selector ES/EN del drawer = EXACTAMENTE el mismo componente que el
      navbar desktop (.nav__lang con su pill deslizante, ~línea 60). El wrapper lleva
      --lang-pos (las custom properties heredan → el ::before deslizante lo lee) y fija
      la paleta oscura del drawer; el CSS móvil sólo lo encoge. {%- endcomment -%}
    <div class="mobile-drawer__lang" style="--lang-pos: {{ lang_pos }};" role="group" aria-label="{{ t_lang }}">
      {%- form 'localization', class: 'nav__lang' -%}
        {%- if lang_es -%}<button type="submit" name="locale_code" value="{{ lang_es.iso_code }}" data-active="{% if cur_iso == 'es' %}true{% else %}false{% endif %}" aria-pressed="{% if cur_iso == 'es' %}true{% else %}false{% endif %}" aria-label="Español" onclick="try{localStorage.setItem('elyxie_lang_choice','es')}catch(e){}">ES</button>{%- endif -%}
        {%- if lang_en -%}<button type="submit" name="locale_code" value="{{ lang_en.iso_code }}" data-active="{% if cur_iso == 'en' %}true{% else %}false{% endif %}" aria-pressed="{% if cur_iso == 'en' %}true{% else %}false{% endif %}" aria-label="English" onclick="try{localStorage.setItem('elyxie_lang_choice','en')}catch(e){}">EN</button>{%- endif -%}
      {%- endform -%}
    </div>

    <div class="mobile-drawer__phones">
      <a href="https://wa.me/51976616514" target="_blank" rel="noopener">WhatsApp · +51 976 616 514</a>
      <a href="mailto:mkt@elyxie.com">mkt@elyxie.com</a>
    </div>

    <a class="mobile-drawer__cta Button Button--ghost" href="{{ contact_url }}">
      {{ t_contact }}
      <span class="Button__arrow">→</span>
    </a>

    <ul class="mobile-drawer__social" aria-label="Social">
      <li><a href="https://www.instagram.com/elyxie.es/" target="_blank" rel="noopener" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a></li>
    </ul>

    <p class="mobile-drawer__copy">{{ t_copy }}</p>
  </div>
</div>

<script>
  /* Burger + drawer móvil — réplica vanilla del comportamiento React:
     toggle con cambio de icono y aria, Escape cierra, scroll del body
     bloqueado mientras está abierto, se cierra al crecer a desktop. */
  (function () {
    var nav = document.getElementById('elyxie-nav');
    var drawer = document.getElementById('elyxie-drawer');
    var btn = nav && nav.querySelector('.nav__icon-btn--menu');
    if (!nav || !drawer || !btn) return;
    var prevOverflow = ['', ''];
    function setOpen(open) {
      nav.setAttribute('data-drawer-open', open ? 'true' : 'false');
      drawer.setAttribute('data-open', open ? 'true' : 'false');
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', btn.getAttribute(open ? 'data-label-close' : 'data-label-open'));
      if (open) {
        prevOverflow = [document.documentElement.style.overflow, document.body.style.overflow];
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      } else {
        document.documentElement.style.overflow = prevOverflow[0];
        document.body.style.overflow = prevOverflow[1];
      }
    }
    function isOpen() { return drawer.getAttribute('data-open') === 'true'; }
    btn.addEventListener('click', function () { setOpen(!isOpen()); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && isOpen()) setOpen(false); });
    window.matchMedia('(min-width: 768px)').addEventListener('change', function (e) { if (e.matches && isOpen()) setOpen(false); });
    drawer.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { setOpen(false); }); });
  })();
</script>
